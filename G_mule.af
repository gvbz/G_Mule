				Chat {/ub bct "clothing_mule" 60000 /vt opt set EnableNav false}
				Chat {/ub bct "clothing_mule" 60000 /mt logout}
	IF:	Expr {listcount[wobjectfindalllandscapebynamerx[`^Gjewelery$`]] > 0 && coordinatedistancewithz[getplayercoordinates[], wobjectgetphysicscoordinates[listgetitem[wobjectfindalllandscapebynamerx[`^Gjewelery$`], 0]]] < 20}
		DO:	DoAll

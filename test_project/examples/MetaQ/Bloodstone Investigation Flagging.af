		DO:	ChatExpr {listgetitem[$ActionList,$ActionIndex]}
	IF:	SecsInStateGE 17
		DO:	ChatExpr {listgetitem[$ActionList,$ActionIndex]}
	IF:	SecsInStateGE 22
		DO:	ChatExpr {listgetitem[$ActionList,$ActionIndex]}
	IF:	SecsInStateGE 27
		DO:	ChatExpr {listgetitem[$ActionList,$ActionIndex]}
	IF:	ChatMatch {If you find any information pertaining to the Bloodstones}
		DO:	SetState {FrozenTombRun}
	IF:	ChatMatch {Kuyiza bint Zayi the Translator gives you Bloodstone Report}
		DO:	SetState {Flagging}
	IF:	ChatMatch {This ritual they mention worries me}
		DO:	SetState {FrozenTombRun}
	IF:	ChatMatch {Kuyiza bint Zayi the Translator gives you Research Notes}
		DO:	SetState {Flagging}
	IF:	ChatMatch {Let us hope Kuyiza transcribed it properly}
		DO:	SetState {Completion}
~~ }
STATE: {FrozenTombRun} ~~ {
	IF:	Always
		DO:	DoAll
				EmbedNav nav1__FrozenTomb_nav {FrozenTomb.nav}
				SetOpt {EnableNav} {True}
				SetOpt {EnableBuffing} {False}
				SetOpt {EnableCombat} {False}
				SetOpt {EnableLooting} {True}
	IF:	All
			NavEmpty
			Expr {getfellowshipisleader[]==1}
		DO:	SetState {LootKey}
	IF:	All
			NavEmpty
			Expr {getfellowshipisleader[]!=1}
		DO:	SetState {Rally}
	IF:	Death
		DO:	SetState {Recover}
~~ }
STATE: {LootKey} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableNav} {False}
				SetOpt {EnableCombat} {False}
				SetOpt {EnableLooting} {False}
	IF:	SecsInStateGE 1
		DO:	ChatExpr {`/ub uselp Corpse of Gurog Soldier`}
	IF:	SecsInStateGE 5
		DO:	DoAll
				ChatExpr {`/mt lootp Entryway Key`}
	IF:	SecsInStateGE 8
		DO:	ChatExpr {`/ub uselp Corpse of Gurog Minion`}
	IF:	SecsInStateGE 10
		DO:	DoAll
				ChatExpr {`/mt lootp Entryway Key`}
	IF:	SecsInStateGE 12
		DO:	SetState {LootKey}
	IF:	ItemCountGE 1 {Entryway Key}
		DO:	DoAll
				ChatExpr {`/ub close corpse`}
				SetState {Rally}
	IF:	Death
		DO:	SetState {Recover}
~~ }
STATE: {Rally} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableNav} {False}
				SetOpt {EnableCombat} {True}
	IF:	All
			SecsInStateGE 5
			Expr {listcontains[getgvar[RalliedChars],getcharstringprop[1]]==0}
		DO:	DoExpr {listadd[getgvar[RalliedChars],getcharstringprop[1]]}
	IF:	All
			Expr {listcount[getgvar[RalliedChars]]==getfellowshipcount[]}
			Expr {$ActionIndex==1}
		DO:	SetState {CarefullyRolledScroll}
	IF:	All
			Expr {listcount[getgvar[RalliedChars]]==getfellowshipcount[]}
			Expr {$ActionIndex==3}
		DO:	SetState {KastellarsLab}
	IF:	SecsInStateGE 30
		DO:	SetState {Rally}
	IF:	Death
		DO:	SetState {Recover}
~~ }
STATE: {CarefullyRolledScroll} ~~ {
	IF:	Expr {getfellowshipisleader[]==1}
		DO:	DoAll
				DoExpr {setgvar[RalliedChars,listcreate[]]}
				EmbedNav nav2___None_ {[none]}
				SetOpt {EnableNav} {True}
	IF:	Always
		DO:	DoAll
				SetOpt {EnableBuffing} {False}
				SetOpt {EnableCombat} {True}
				SetOpt {EnableLooting} {True}
	IF:	Expr {wobjectgetisdooropen[wobjectfindnearestdoor[]]==1}
		DO:	DoAll
				EmbedNav nav3__FrozenTombRunOne_nav {FrozenTombRunOne.nav}
				SetOpt {EnableNav} {True}
	IF:	NavEmpty
		DO:	DoAll
				EmbedNav nav4___None_ {[none]}
	IF:	ItemCountGE 1 {Carefully rolled scroll}
		DO:	SetState {Translation}
	IF:	Death
		DO:	SetState {Recover}
~~ }
STATE: {Translation} ~~ {
	IF:	Always
		DO:	DoAll
				EmbedNav nav5__ScrollTranslation_nav {ScrollTranslation.nav}
				SetOpt {EnableNav} {True}
				SetOpt {EnableBuffing} {False}
				SetOpt {EnableCombat} {True}
				SetOpt {EnableLooting} {True}
	IF:	NavEmpty
		DO:	DoAll
				SetState {ExecuteAction}
	IF:	Death
		DO:	SetState {Recover}
~~ }
STATE: {KastellarsLab} ~~ {
	IF:	Expr {getfellowshipisleader[]==1}
		DO:	DoAll
				DoExpr {setgvar[RalliedChars,listcreate[]]}
				EmbedNav nav6___None_ {[none]}
				SetOpt {EnableNav} {True}
	IF:	Always
		DO:	DoAll
				SetOpt {EnableBuffing} {False}
				SetOpt {EnableCombat} {True}
				SetOpt {EnableLooting} {True}
	IF:	Expr {wobjectgetisdooropen[wobjectfindnearestdoor[]]==1}
		DO:	DoAll
				EmbedNav nav7__FrozenTombRunTwo_nav {FrozenTombRunTwo.nav}
				SetOpt {EnableNav} {True}
	IF:	NavEmpty
		DO:	DoAll
				SetOpt {EnableLooting} {False}
				EmbedNav nav8___None_ {[none]}
	IF:	ItemCountGE 1 {Large Tome}
		DO:	DoAll
				ChatExpr {`/ub close corpse`}
				SetState {Translation}
	IF:	Death
		DO:	SetState {Recover}
~~ }
STATE: {Completion} ~~ {
	IF:	All
			Expr {&MetaQueueStart==1}
			Expr {listgetitem[&MetaQueue,listindexof[&MetaQueue,`Bloodstone Investigation Flagging`]+1]==`Bloodstone Factory`}
			Expr {getfellowshipisleader[]==1}
		DO:	DoExpr {&MetaStage=&MetaStage+1}
	IF:	All
			Expr {&MetaQueueStart==1}
			Expr {listgetitem[&MetaQueue,listindexof[&MetaQueue,`Bloodstone Investigation Flagging`]+1]==`Bloodstone Factory`}
		DO:	ChatExpr {`/vt meta load MetaQ`}
	IF:	SecsInStateGE 3
		DO:	SetState {Finished}
~~ }
STATE: {Finished} ~~ {
	IF:	Always
		DO:	DoAll
				ChatExpr {`/vt settings load `+getcharstringprop[1]+`TempBackup`}
	IF:	All
			Expr {getfellowshipisleader[]==1}
			Expr {&MetaQueueStart==1}
		DO:	DoExpr {&MetaStage=&MetaStage+1}
	IF:	SecsInStateGE 1
		DO:	DoAll
				EmbedNav nav9__NavToMansion_nav {NavToMansion.nav}
				SetOpt {EnableNav} {True}
	IF:	All
			SecsInStateGE 60
			Expr {&MetaQueueStart==1}
			NavEmpty
		DO:	ChatExpr {`/vt meta load MetaQ`}
~~ }
STATE: {Recover} ~~ {
	IF:	Always
		DO:	DoAll
				ChatExpr {`/vt settings load `+getcharstringprop[1]+`TempBackup`}
	IF:	Expr {getfellowshipisleader[]==1}
		DO:	ChatExpr {`/vt meta load MetaQAbort`}
	IF:	SecsInStateGE 1
		DO:	DoAll
				DoExpr {$RecoveryMode=1}
				ChatExpr {`/vt meta load MetaQ`}
~~ }


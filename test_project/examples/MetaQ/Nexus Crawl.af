				SetOpt {AttackDistance} {0.02083333}
				SetOpt {NavCloseStopRange} {0.0080333333}
				SetOpt {SummonPets} {True}
				SetOpt {OpenDoors} {True}
				SetOpt {NavPriorityBoost} {False}
				SetOpt {FollowAroundCorners} {True}

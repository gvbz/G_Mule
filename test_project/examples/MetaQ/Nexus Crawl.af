STATE: {***SETTINGS***} ~~ {
	IF:	Always
		DO:	DoAll
				DoExpr {$CharacterOne=`Jiggiwatt`}
				DoExpr {$CharacterTwo=`Jiggi-Mage`}
				DoExpr {$CharacterThree=`Werecur`}
				DoExpr {$CharacterFour=`Al Organic`}
				DoExpr {$CharacterFive=`Airmed`}
				DoExpr {$CharacterSix=`Abyssal Watchman`}
				DoExpr {$CharacterSeven=`Void Rage`}
				DoExpr {$CharacterEight=`Mad Jack Churchill`}
				DoExpr {$CharacterNine=`Artsin Crafts`}
				DoExpr {$NexusTies=dictcreate[`Jiggi-Mage`,`Secondary`,`Magical Mike`,`Secondary`]}
				DoExpr {$LootProfile=`Farming.utl`}
	IF:	SecsInStateGE 1
		DO:	DoAll
				ChatExpr {`/vt loot load`+$LootProfile}
	IF:	Expr {getfellowshipstatus[]==0}
		DO:	Chat {/ub fellow create Derp Patrol}
	IF:	All
			SecsInStateGE 2
			Expr {getfellowshipisleader[]==1}
		DO:	DoAll
				ChatExpr {`/ub fellow recruit `+$CharacterOne}
				ChatExpr {`/ub fellow recruit `+$CharacterTwo}
				ChatExpr {`/ub fellow recruit `+$CharacterThree}
				ChatExpr {`/ub fellow recruit `+$CharacterFour}
				ChatExpr {`/ub fellow recruit `+$CharacterFive}

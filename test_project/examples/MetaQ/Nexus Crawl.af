				SetOpt {LootOnlyRareCorpses} {True}
				ChatExpr {`/vt loot load`+$LootProfile}
				Chat {/ub opt set VTank.PatchExpressionEngine true}
	IF:	All
			SecsInStateGE 2
			Expr {&MetaQueueStart==1}
		DO:	SetState {MetaQueueStart}
	IF:	SecsInStateGE 5
		DO:	SetState {***SETTINGS***}
~~ }
STATE: {MetaQueueStart} ~~ {
	IF:	Always
		DO:	DoExpr {setvar[LeaderName,wobjectgetname[wobjectfindbyid[getfellowshipleaderid[]]]]}
	IF:	Expr {getfellowshipisleader[]==1}
		DO:	DoAll
				Chat {/me will be the leader of this group. Starting Nexus Crawl.}
				DoExpr {setgvar[RalliedChars,listcreate[]]}
				ChatExpr {`IMPORTANT: One of the following characters, `+dictkeys[$NexusTies]+`, must be part of the group and have a, `+dictvalues[$NexusTies]+`, (respectively) portal tie to The Nexus.`}
	IF:	Expr {testpvar[Trinkets]!=0}
		DO:	DoExpr {$TurnInEquipment=1}
	IF:	SecsInStateGE 5
		DO:	SetState {Buffing}
~~ }
STATE: {Buffing} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableBuffing} {True}
				Chat {/vt forcebuff}
				DoExpr {$SettingsApplied=0}
	IF:	All
			Expr {getfellowshipisleader[]==1}
			SecsInStateGE 180
		DO:	DoAll
				Chat {/f Tally ho!}
				SetState {Flagging}
	IF:	ChatMatch {Tally ho!}
		DO:	SetState {Flagging}
~~ }
STATE: {Flagging} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableBuffing} {False}
				SetOpt {EnableLooting} {False}
				SetOpt {EnableNav} {True}
				EmbedNav nav0__Nexus_Crawl___Flagging_nav {Nexus Crawl - Flagging.nav}
	IF:	SecsInStateGE 60
		DO:	SetState {Travelling}
~~ }
STATE: {Travelling} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableBuffing} {False}
				SetOpt {EnableCombat} {False}
				SetOpt {EnableLooting} {False}
				SetOpt {EnableNav} {False}
				EmbedNav nav1__Nexus_Crawl___Portal_Buddy_nav {Nexus Crawl - Portal Buddy.nav}
	IF:	Expr {dicthaskey[$NexusTies,getcharstringprop[1]]}
		DO:	DoAll
				DoExpr {ifthen[dictgetitem[$NexusTies,getcharstringprop[1]]==`Primary`,`$SpellId=157`,`$SpellId=2648`]}
				SetOpt {IdlePeaceMode} {False}
	IF:	All
			Expr {dicthaskey[$NexusTies,getcharstringprop[1]]}
			Expr {actiontrycastbyid[$SpellId]==1}
			SecsInStateGE 10
		DO:	Chat {/f Portal up!}
	IF:	ChatMatch {Portal up!}
		DO:	SetOpt {EnableNav} {True}
	IF:	All
			SecsInStateGE 20
			NavEmpty
		DO:	SetState {Nexus Crawl Run Pt1}
	IF:	Death
		DO:	SetState {Recover}
~~ }
STATE: {Nexus Crawl Run Pt1} ~~ {
	IF:	Always
		DO:	DoAll
				EmbedNav nav2__Nexus_Crawl___Run_Through_Pt1_nav {Nexus Crawl - Run Through Pt1.nav}
				SetOpt {EnableBuffing} {False}
				SetOpt {EnableCombat} {True}
				SetOpt {EnableLooting} {True}
				SetOpt {EnableNav} {True}
				SetWatchdog 5 300 {Recover}
	IF:	NavEmpty
		DO:	SetState {Rally}
	IF:	Death
		DO:	SetState {Recover}
~~ }
STATE: {Nexus Crawl Run Pt2} ~~ {
	IF:	Expr {getfellowshipisleader[]==1}
		DO:	Chat {/ub uselp lever}
	IF:	Always
		DO:	DoAll
				EmbedNav nav3__Nexus_Crawl___Run_Through_Pt2_nav {Nexus Crawl - Run Through Pt2.nav}
				SetOpt {EnableBuffing} {False}
				SetOpt {EnableCombat} {True}
				SetOpt {EnableLooting} {True}
				SetOpt {EnableNav} {True}
				SetWatchdog 5 300 {Recover}
	IF:	NavEmpty
		DO:	SetState {Apostate Fight}
	IF:	Death
		DO:	SetState {Recover}
~~ }
STATE: {Rally} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableNav} {False}
				SetOpt {EnableCombat} {True}
				ClearWatchdog
	IF:	All
			SecsInStateGE 5
			Expr {listcontains[getgvar[RalliedChars],getcharstringprop[1]]==0}
		DO:	DoExpr {listadd[getgvar[RalliedChars],getcharstringprop[1]]}
	IF:	Expr {listcount[getgvar[RalliedChars]]==getfellowshipcount[]}
		DO:	SetState {Nexus Crawl Run Pt2}
	IF:	SecsInStateGE 30
		DO:	SetState {Rally}
	IF:	Death
		DO:	SetState {Recover}
~~ }
STATE: {Apostate Fight} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableCombat} {True}
				SetOpt {EnableLooting} {False}
				SetOpt {EnableNav} {True}
				ClearWatchdog
	IF:	All
			Expr {getfellowshipisleader[]==1}
			SecsInStateGE 20
		DO:	EmbedNav nav4__Nexus_Crawl___Apostate_Master_nav {Nexus Crawl - Apostate Master.nav}
	IF:	All
			Expr {getfellowshipisleader[]==1}
			ItemCountGE 1 {Aetherium Vault Key}
		DO:	DoAll
				Chat {/f Follow me, friends!}
				SetState {Resonator}
	IF:	ChatMatch {Follow me, friends!}
		DO:	SetState {Resonator}
	IF:	Death
		DO:	SetState {Recover}
~~ }
STATE: {Resonator} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableCombat} {True}
				SetOpt {EnableLooting} {False}
				SetOpt {EnableNav} {True}
				EmbedNav nav5__Nexus_Crawl___Resonator_nav {Nexus Crawl - Resonator.nav}
	IF:	ChatMatch {you know that your task is done}
		DO:	SetState {Completion}
	IF:	Death
		DO:	SetState {Recover}
~~ }
STATE: {Completion} ~~ {
	IF:	Expr {$TurnInEquipment==1}
		DO:	CallState {EquipEquipment} {Completion}
	IF:	Expr {getcharquadprop[6]>=1490000}
		DO:	DoAll
				ChatExpr {`/t `+getcharstringprop[1]+`, I am close to max luminance, so I am going to skip turn-in.`}
				SetState {Finished}
	IF:	Always
		DO:	DoAll
				SetOpt {EnableCombat} {False}
				SetOpt {EnableLooting} {False}
				SetOpt {EnableNav} {True}
				EmbedNav nav6__Nexus_Crawl___Completion_nav {Nexus Crawl - Completion.nav}
				ClearWatchdog
	IF:	NavEmpty
		DO:	SetState {Finished}
~~ }
STATE: {EquipEquipment} ~~ {
	IF:	Expr {testpvar[Trinkets]==0||@Trinkets{{TurnInTrinket}}==`NotSet`||@Trinkets{{DefaultTrinket}}==`NotSet`}
		DO:	Return
	IF:	Expr {$TurnInEquipment==1}
		DO:	ChatExpr {`/mt dequip `+@Trinkets{{DefaultTrinket}}}
	IF:	All
			Expr {$TurnInEquipment==1}
			SecsInStateGE 2
		DO:	DoAll
				ChatExpr {`/mt equip `+@Trinkets{{TurnInTrinket}}}
				DoExpr {$TurnInEquipment=2}
				Return
	IF:	Expr {$TurnInEquipment==2}
		DO:	ChatExpr {`/mt dequip `+@Trinkets{{TurnInTrinket}}}
	IF:	All
			Expr {$TurnInEquipment==2}
			SecsInStateGE 2
		DO:	DoAll
				ChatExpr {`/mt equip `+@Trinkets{{DefaultTrinket}}}
				DoExpr {$TurnInEquipment=0}
				Return
~~ }
STATE: {Finished} ~~ {
	IF:	Always
		DO:	DoAll
				ChatExpr {`/vt settings load `+getcharstringprop[1]+`TempBackup`}
	IF:	All
			Expr {getfellowshipisleader[]==1}
			Expr {&MetaQueueStart==1}
		DO:	DoAll
				DoExpr {&MetaStage=&MetaStage+1}
				DoExpr {cleargvar[RalliedChars]}
	IF:	SecsInStateGE 1
		DO:	DoAll
				EmbedNav nav7__NavToMansion_nav {NavToMansion.nav}
				SetOpt {EnableNav} {True}
	IF:	All
			SecsInStateGE 60
			Expr {&MetaQueueStart==1}
			NavEmpty
		DO:	ChatExpr {`/vt meta load MetaQ`}
~~ }
STATE: {Recover} ~~ {
	IF:	Always
		DO:	DoAll
				ChatExpr {`/vt settings load `+getcharstringprop[1]+`TempBackup`}
	IF:	Expr {getfellowshipisleader[]==1}
		DO:	ChatExpr {`/vt meta load MetaQAbort`}
	IF:	SecsInStateGE 1
		DO:	DoAll
				DoExpr {$RecoveryMode=1}
				ChatExpr {`/vt meta load MetaQ`}
~~ }


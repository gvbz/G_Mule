STATE: {Buffing} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableBuffing} {True}
				Chat {/vt forcebuff}
				DoExpr {$SettingsApplied=0}
	IF:	All
			Expr {getfellowshipisleader[]==1}
			SecsInStateGE 180
		DO:	DoAll
				Chat {/f Tally ho!}
				SetState {Flagging}
	IF:	ChatMatch {Tally ho!}
		DO:	SetState {Flagging}
~~ }
STATE: {Rally} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableNav} {False}
				SetOpt {EnableCombat} {True}
				ClearWatchdog
	IF:	All
			SecsInStateGE 5
			Expr {listcontains[getgvar[RalliedChars],getcharstringprop[1]]==0}
		DO:	DoExpr {listadd[getgvar[RalliedChars],getcharstringprop[1]]}
	IF:	Expr {listcount[getgvar[RalliedChars]]==getfellowshipcount[]}
		DO:	SetState {Fighting}
	IF:	SecsInStateGE 30
		DO:	SetState {Rally}
~~ }
STATE: {Flagging} ~~ {
	IF:	Always
		DO:	DoAll
				EmbedNav nav0__Rynthid_KT_Flagging_nav {Rynthid KT Flagging.nav}
				SetOpt {EnableBuffing} {False}
				SetOpt {EnableCombat} {False}
				SetOpt {EnableLooting} {False}
				SetOpt {EnableNav} {True}
				SetWatchdog 10 120 {Flagging}
	IF:	NavEmpty
		DO:	SetState {Rally}
~~ }
STATE: {Fighting} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableBuffing} {True}
				SetOpt {EnableCombat} {True}
				SetOpt {EnableLooting} {True}
	IF:	Expr {getfellowshipisleader[]==1}
		DO:	EmbedNav nav1__Rynthid_KT_Patrol_nav {Rynthid KT Patrol.nav}
	IF:	Expr {getfellowshipisleader[]==0}
		DO:	DoAll
				ChatExpr {`/ub follow `+getvar[LeaderName]}
				SetOpt {NavPriorityBoost} {True}
	IF:	SecsInStateGE 1
		DO:	SetOpt {EnableNav} {True}
	IF:	All
			Expr {getfellowshipisleader[]==1}
			SecsInStateGE 10
		DO:	DoExpr {cleargvar[RalliedChars]}
	IF:	All
			Expr {getvar[TaskMinions]==1}
			Expr {getvar[TaskRifts]==1}
			Expr {getvar[TaskSlayers]==1}
			Expr {getvar[TaskSorcerers]==1}
			Expr {getvar[TaskRagers]==1}
			Expr {getvar[TaskCrystals]==1}
		DO:	SetState {Completion}
	IF:	ChatMatch {Cheese it, it's the fuzz!}
		DO:	SetState {Completion}
	IF:	Any
			ChatMatch {Rynthid Minion of Rages! Your task is complete}
			ChatMatch {Minions! Your task is complete}
		DO:	DoExpr {setvar[TaskMinions, 1]}
	IF:	Any
			ChatMatch {Rift of Consuming Torments! Your task is complete}
			ChatMatch {Rift of Blind Rages! Your task is complete}
		DO:	DoExpr {setvar[TaskRifts, 1]}
	IF:	ChatMatch {Slayers! Your task is complete}
		DO:	DoExpr {setvar[TaskSlayers, 1]}
	IF:	ChatMatch {Sorcerers! Your task is complete}
		DO:	DoExpr {setvar[TaskSorcerers, 1]}
	IF:	ChatMatch {Ragers! Your task is complete}
		DO:	DoExpr {setvar[TaskRagers, 1]}
	IF:	ChatMatch {Crystals! Your task is complete}
		DO:	DoExpr {setvar[TaskCrystals, 1]}
	IF:	Death
		DO:	SetState {ReturnOnDeath}
	IF:	ChatMatch {Everyone get your butts home}
		DO:	SetState {Finished}
~~ }
STATE: {ReturnOnDeath} ~~ {
	IF:	Always
		DO:	DoAll
				EmbedNav nav2__Rynthid___Return_nav {Rynthid - Return.nav}
				SetOpt {EnableNav} {True}
				SetOpt {EnableBuffing} {True}
	IF:	All
			Expr {wobjectfindnearestbynameandobjectclass[24,&MetaLeader]!=0}
			Expr {coordinatedistancewithz[getplayercoordinates[], wobjectgetphysicscoordinates[wobjectfindnearestbynameandobjectclass[24,&MetaLeader]]]<=80}
		DO:	SetState {Fighting}
	IF:	ChatMatch {Cheese it, it's the fuzz!}
		DO:	SetState {Completion}
	IF:	ChatMatch {Everyone get your butts home}
		DO:	SetState {Finished}
~~ }
STATE: {Completion} ~~ {
	IF:	Expr {$TurnInEquipment==1}
		DO:	CallState {EquipEquipment} {Completion}
	IF:	Expr {getcharquadprop[6]>=1490000}
		DO:	DoAll
				ChatExpr {`/t `+getcharstringprop[1]+`, I am close to max luminance, so I am going to skip turn-in.`}
				SetState {Finished}
	IF:	Always
		DO:	DoAll
				Chat {/f Cheese it, it's the fuzz!}
				Chat {/me decides to make a break for it.}
				EmbedNav nav3__Rynthid___Completion_nav {Rynthid - Completion.nav}
				SetOpt {EnableCombat} {False}
				SetOpt {EnableLooting} {False}
				SetOpt {EnableNav} {True}
	IF:	NavEmpty
		DO:	SetState {Finished}
~~ }
STATE: {EquipEquipment} ~~ {
	IF:	Expr {testpvar[Trinkets]==0||@Trinkets{{TurnInTrinket}}==`NotSet`||@Trinkets{{DefaultTrinket}}==`NotSet`}
		DO:	Return
	IF:	Expr {$TurnInEquipment==1}
		DO:	ChatExpr {`/mt dequip `+@Trinkets{{DefaultTrinket}}}
	IF:	All
			Expr {$TurnInEquipment==1}
			SecsInStateGE 2
		DO:	DoAll
				ChatExpr {`/mt equip `+@Trinkets{{TurnInTrinket}}}
				DoExpr {$TurnInEquipment=2}
				Return
	IF:	Expr {$TurnInEquipment==2}
		DO:	ChatExpr {`/mt dequip `+@Trinkets{{TurnInTrinket}}}
	IF:	All
			Expr {$TurnInEquipment==2}
			SecsInStateGE 2
		DO:	DoAll
				ChatExpr {`/mt equip `+@Trinkets{{DefaultTrinket}}}
				DoExpr {$TurnInEquipment=0}
				Return
~~ }
STATE: {Finished} ~~ {
	IF:	Always
		DO:	DoAll
				ChatExpr {`/vt settings load `+getcharstringprop[1]+`TempBackup`}
	IF:	All
			Expr {getfellowshipisleader[]==1}
			Expr {&MetaQueueStart==1}
		DO:	DoAll
				DoExpr {&MetaStage=&MetaStage+1}
				DoExpr {cleargvar[RalliedChars]}
	IF:	SecsInStateGE 1
		DO:	DoAll
				EmbedNav nav4__NavToMansion_nav {NavToMansion.nav}
				SetOpt {EnableNav} {True}
				SetOpt {NavPriorityBoost} {False}
	IF:	All
			SecsInStateGE 60
			Expr {&MetaQueueStart==1}
			NavEmpty
		DO:	ChatExpr {`/vt meta load MetaQ`}
~~ }


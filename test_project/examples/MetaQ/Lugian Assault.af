		DO:	SetState {Recover}
~~ }
STATE: {Rally} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableNav} {False}
				SetOpt {EnableCombat} {True}
				ClearWatchdog
	IF:	All
			SecsInStateGE 5
			Expr {listcontains[getgvar[RalliedChars],getcharstringprop[1]]==0}
		DO:	DoExpr {listadd[getgvar[RalliedChars],getcharstringprop[1]]}
	IF:	Expr {listcount[getgvar[RalliedChars]]==getfellowshipcount[]}
		DO:	SetState {LugianAssault}
	IF:	SecsInStateGE 30
		DO:	SetState {Rally}
	IF:	Death
		DO:	SetState {Recover}
~~ }
STATE: {LugianAssault} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableNav} {True}
				SetOpt {EnableBuffing} {False}
				SetOpt {EnableCombat} {True}
				SetOpt {EnableLooting} {True}
				SetOpt {NavPriorityBoost} {True}
				SetOpt {CastDispelSelf} {True}
	IF:	All
			Expr {getfellowshipisleader[]==1}
			Expr {wobjectfindnearestbynameandobjectclass[27, Corpse of Captain Keeson]!=0}
			Expr {$LootComplete!=1}
		DO:	SetState {Looting}
	IF:	All
			Expr {getfellowshipisleader[]==0}
			ChatMatch {Door is open, get moving!}
		DO:	DoAll
				SetOpt {EnableNav} {True}
				SetState {LugianAssault}
	IF:	NavEmpty
		DO:	EmbedNav nav3___None_ {[none]}
	IF:	ItemCountGE 1 {Sealed Scroll for Raksaa}
		DO:	SetState {Completion}
	IF:	Death
		DO:	SetState {Recover}
~~ }
STATE: {Looting} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableNav} {False}
				SetOpt {EnableCombat} {False}
				SetOpt {EnableLooting} {False}
				ChatExpr {`/ub usel Corpse of Captain Keeson`}
	IF:	SecsInStateGE 6
		DO:	DoAll
				ChatExpr {`/mt lootp Treasury Key`}
	IF:	SecsInStateGE 10
		DO:	SetState {Looting}
	IF:	Expr {wobjectfindininventorybyname[Treasury Key]!=0}
		DO:	DoAll
				DoExpr {$LootComplete=1}
				SetOpt {EnableNav} {True}
				SetState {LugianAssault}
	IF:	Death
		DO:	SetState {Recover}
~~ }
STATE: {Completion} ~~ {
	IF:	Expr {$TurnInEquipment==1}
		DO:	CallState {EquipEquipment} {Completion}
	IF:	Expr {getcharquadprop[6]>=1490000}
		DO:	DoAll
				ChatExpr {`/t `+getcharstringprop[1]+`, I am close to max luminance, so I am going to skip turn-in.`}
				SetState {Finished}
	IF:	Always
		DO:	DoAll
				EmbedNav nav4__Lugian_Assault_Turn_In_nav {Lugian Assault Turn In.nav}
				SetOpt {EnableNav} {True}
				SetOpt {EnableBuffing} {False}
				SetOpt {EnableCombat} {False}
				SetOpt {EnableLooting} {False}
	IF:	ChatMatch {Raksaa gives you Casting Stone}
		DO:	SetState {Finished}
	IF:	SecsInStateGE 90
		DO:	SetState {Completion}
~~ }
STATE: {EquipEquipment} ~~ {
	IF:	Expr {testpvar[Trinkets]==0||@Trinkets{{TurnInTrinket}}==`NotSet`||@Trinkets{{DefaultTrinket}}==`NotSet`}
		DO:	Return
	IF:	Expr {$TurnInEquipment==1}
		DO:	ChatExpr {`/mt dequip `+@Trinkets{{DefaultTrinket}}}
	IF:	All
			Expr {$TurnInEquipment==1}
			SecsInStateGE 2
		DO:	DoAll
				ChatExpr {`/mt equip `+@Trinkets{{TurnInTrinket}}}
				DoExpr {$TurnInEquipment=2}
				Return
	IF:	Expr {$TurnInEquipment==2}
		DO:	ChatExpr {`/mt dequip `+@Trinkets{{TurnInTrinket}}}
	IF:	All
			Expr {$TurnInEquipment==2}
			SecsInStateGE 2
		DO:	DoAll
				ChatExpr {`/mt equip `+@Trinkets{{DefaultTrinket}}}
				DoExpr {$TurnInEquipment=0}
				Return
~~ }
STATE: {Finished} ~~ {
	IF:	Always
		DO:	DoAll
				ChatExpr {`/vt settings load `+getcharstringprop[1]+`TempBackup`}
				SetOpt {NavPriorityBoost} {False}
	IF:	All
			Expr {getfellowshipisleader[]==1}
			Expr {&MetaQueueStart==1}
		DO:	DoExpr {&MetaStage=&MetaStage+1}
	IF:	SecsInStateGE 1
		DO:	DoAll
				EmbedNav nav5__NavToMansion_nav {NavToMansion.nav}
				SetOpt {EnableNav} {True}
	IF:	All
			SecsInStateGE 60
			Expr {&MetaQueueStart==1}
			NavEmpty
		DO:	ChatExpr {`/vt meta load MetaQ`}
~~ }
STATE: {Recover} ~~ {
	IF:	Always
		DO:	DoAll
				ChatExpr {`/vt settings load `+getcharstringprop[1]+`TempBackup`}
	IF:	Expr {getfellowshipisleader[]==1}
		DO:	ChatExpr {`/vt meta load MetaQAbort`}
	IF:	SecsInStateGE 1
		DO:	DoAll
				DoExpr {$RecoveryMode=1}
				ChatExpr {`/vt meta load MetaQ`}
~~ }


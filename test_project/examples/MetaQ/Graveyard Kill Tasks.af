STATE: {MetaQueueStart} ~~ {
	IF:	Always
		DO:	DoExpr {setvar[LeaderName,wobjectgetname[wobjectfindbyid[getfellowshipleaderid[]]]]}
	IF:	Expr {getfellowshipisleader[]==1}
		DO:	DoAll
				DoExpr {setgvar[RalliedChars,listcreate[]]}
				Chat {/me will be the leader of this group. Starting Graveyard Kill Tasks}
	IF:	Expr {testpvar[Trinkets]!=0}
		DO:	DoExpr {$TurnInEquipment=1}
	IF:	SecsInStateGE 5
		DO:	SetState {Buffing}
~~ }
STATE: {Buffing} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableBuffing} {True}
				Chat {/vt forcebuff}
				DoExpr {$SettingsApplied=0}
	IF:	All
			Expr {getfellowshipisleader[]==1}
			SecsInStateGE 180
		DO:	DoAll
				Chat {/f Tally ho!}
				SetState {Flagging}
	IF:	ChatMatch {Tally ho!}
		DO:	SetState {Flagging}
~~ }
STATE: {Rally} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableNav} {False}
				SetOpt {EnableCombat} {True}
				ClearWatchdog
	IF:	All
			SecsInStateGE 5
			Expr {listcontains[getgvar[RalliedChars],getcharstringprop[1]]==0}
		DO:	DoExpr {listadd[getgvar[RalliedChars],getcharstringprop[1]]}
	IF:	Expr {listcount[getgvar[RalliedChars]]==getfellowshipcount[]}
		DO:	SetState {Fighting}
	IF:	SecsInStateGE 30
		DO:	SetState {Rally}
~~ }
STATE: {Flagging} ~~ {
	IF:	Always
		DO:	DoAll
				EmbedNav nav0__Graveyard___Flagging_nav {Graveyard - Flagging.nav}
				SetOpt {EnableBuffing} {False}
				SetOpt {EnableCombat} {False}
				SetOpt {EnableLooting} {False}
				SetOpt {EnableNav} {True}
				SetWatchdog 10 120 {Flagging}
	IF:	NavEmpty
		DO:	SetState {Rally}
~~ }
STATE: {Fighting} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableBuffing} {True}
				SetOpt {EnableCombat} {True}
				SetOpt {EnableLooting} {True}
	IF:	Expr {getfellowshipisleader[]==1}
		DO:	EmbedNav nav1__Graveyard___Patrol_nav {Graveyard - Patrol.nav}
	IF:	Expr {getfellowshipisleader[]==0}
		DO:	DoAll
				ChatExpr {`/ub follow `+getvar[LeaderName]}
				SetOpt {NavPriorityBoost} {True}
	IF:	SecsInStateGE 1
		DO:	SetOpt {EnableNav} {True}
	IF:	All
			Expr {getfellowshipisleader[]==1}
			SecsInStateGE 10
		DO:	DoExpr {cleargvar[RalliedChars]}
	IF:	All
			Expr {getvar[TaskSpirits]==1}
			Expr {getvar[TaskWisps]==1}
			Expr {getvar[TaskSkeletons]==1}
			Expr {getvar[TaskWights]==1}
		DO:	SetState {Completion}
	IF:	ChatMatch {Cheese it, it's the fuzz!}
		DO:	SetState {Completion}
	IF:	ChatMatch {Dreads! Your task is complete}
		DO:	DoExpr {setvar[TaskSpirits, 1]}
	IF:	ChatMatch {Wisps! Your task is complete}
		DO:	DoExpr {setvar[TaskWisps, 1]}
	IF:	ChatMatch {You have killed 30 Pyre}
		DO:	DoExpr {setvar[TaskSkeletons, 1]}
	IF:	ChatMatch {You have killed 30 Wight}
		DO:	DoExpr {setvar[TaskWights, 1]}
	IF:	Death
		DO:	SetState {Return on Death}
	IF:	ChatMatch {Everyone get your butts home}
		DO:	SetState {Finished}
~~ }
STATE: {Return on Death} ~~ {
	IF:	Always
		DO:	DoAll
				EmbedNav nav2__Graveyard___Return_nav {Graveyard - Return.nav}
				SetOpt {EnableNav} {True}
				SetOpt {EnableBuffing} {True}
	IF:	NavEmpty
		DO:	SetState {Fighting}
~~ }
STATE: {Completion} ~~ {
	IF:	Expr {$TurnInEquipment==1}
		DO:	CallState {EquipEquipment} {Completion}
	IF:	Expr {getcharquadprop[6]>=1490000}
		DO:	DoAll
				ChatExpr {`/t `+getcharstringprop[1]+`, I am close to max luminance, so I am going to skip turn-in.`}
				SetState {Finished}
	IF:	Always
		DO:	DoAll
				Chat {/f Cheese it, it's the fuzz!}
				Chat {/me decides to make a break for it.}
				EmbedNav nav3__Graveyard___Completion_nav {Graveyard - Completion.nav}
				SetOpt {EnableCombat} {False}
				SetOpt {EnableLooting} {False}
				SetOpt {EnableNav} {True}
	IF:	NavEmpty
		DO:	SetState {Finished}
~~ }
STATE: {EquipEquipment} ~~ {
	IF:	Expr {testpvar[Trinkets]==0||@Trinkets{{TurnInTrinket}}==`NotSet`||@Trinkets{{DefaultTrinket}}==`NotSet`}
		DO:	Return
	IF:	Expr {$TurnInEquipment==1}
		DO:	ChatExpr {`/mt dequip `+@Trinkets{{DefaultTrinket}}}
	IF:	All
			Expr {$TurnInEquipment==1}
			SecsInStateGE 2
		DO:	DoAll
				ChatExpr {`/mt equip `+@Trinkets{{TurnInTrinket}}}
				DoExpr {$TurnInEquipment=2}
				Return
	IF:	Expr {$TurnInEquipment==2}
		DO:	ChatExpr {`/mt dequip `+@Trinkets{{TurnInTrinket}}}
	IF:	All
			Expr {$TurnInEquipment==2}
			SecsInStateGE 2
		DO:	DoAll
				ChatExpr {`/mt equip `+@Trinkets{{DefaultTrinket}}}
				DoExpr {$TurnInEquipment=0}
				Return
~~ }
STATE: {Finished} ~~ {
	IF:	Always
		DO:	DoAll
				ChatExpr {`/vt settings load `+getcharstringprop[1]+`TempBackup`}
	IF:	All
			Expr {getfellowshipisleader[]==1}
			Expr {&MetaQueueStart==1}
		DO:	DoAll
				DoExpr {&MetaStage=&MetaStage+1}
				DoExpr {cleargvar[RalliedChars]}
	IF:	SecsInStateGE 1
		DO:	DoAll
				EmbedNav nav4__NavToMansion_nav {NavToMansion.nav}
				SetOpt {EnableNav} {True}
	IF:	All
			SecsInStateGE 60
			Expr {&MetaQueueStart==1}
			NavEmpty
		DO:	ChatExpr {`/vt meta load MetaQ`}
~~ }


				EmbedNav nav1__Falatacot_Depot___Travel_nav {Falatacot Depot - Travel.nav}
				SetWatchdog 10 60 {Flagging}
	IF:	NavEmpty
		DO:	SetState {Rally}
	IF:	Death
		DO:	SetState {Recover}
~~ }
STATE: {Rally} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableNav} {False}
				SetOpt {EnableCombat} {True}
				ClearWatchdog
	IF:	All
			SecsInStateGE 5
			Expr {listcontains[getgvar[RalliedChars],getcharstringprop[1]]==0}
		DO:	DoExpr {listadd[getgvar[RalliedChars],getcharstringprop[1]]}
	IF:	Expr {listcount[getgvar[RalliedChars]]==getfellowshipcount[]}
		DO:	SetState {Falatacot Depot Run Through}
	IF:	SecsInStateGE 30
		DO:	SetState {Rally}
	IF:	Death
		DO:	SetState {Recover}
~~ }
STATE: {Falatacot Depot Run Through} ~~ {
	IF:	Always
		DO:	DoAll
				EmbedNav nav2__Falatacot_Depot___Run_Through_nav {Falatacot Depot - Run Through.nav}
				SetOpt {EnableBuffing} {False}
				SetOpt {EnableCombat} {True}
				SetOpt {EnableLooting} {True}
				SetOpt {EnableNav} {True}
				SetWatchdog 10 300 {Recover}
	IF:	NavEmpty
		DO:	DoAll
				ClearWatchdog
				SetState {Zrikux Loot}
	IF:	Death
		DO:	SetState {Recover}
~~ }
STATE: {Zrikux Loot} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableCombat} {True}
				SetOpt {EnableLooting} {False}
				SetOpt {EnableNav} {True}
				EmbedNav nav3___None_ {[none]}
	IF:	ItemCountGE 1 {Orders for Zrikux}
		DO:	DoAll
				SetOpt {EnableNav} {False}
				Chat {/ub close corpse}
				DoExpr {&LootCount=&LootCount+1}
	IF:	All
			Expr {&LootCount==getfellowshipcount[]}
			SecsInStateGE 30
		DO:	SetState {Translation}
	IF:	Death
		DO:	SetState {Recover}
~~ }
STATE: {Translation} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableCombat} {False}
				SetOpt {EnableLooting} {False}
				SetOpt {EnableNav} {True}
				EmbedNav nav4__Falatacot_Depot___Translation_nav {Falatacot Depot - Translation.nav}
	IF:	All
			NavEmpty
			Expr {getfellowshipisleader[]==1}
		DO:	ChatExpr {`/ub bct FalatacotGroup 5000 /ub give Orders for Zrikux to Fanzen San the Translator`}
	IF:	ItemCountGE 1 {Translated Orders for Zrikux}
		DO:	SetState {Completion}
~~ }
STATE: {Completion} ~~ {
	IF:	Expr {$TurnInEquipment==1}
		DO:	CallState {EquipEquipment} {Completion}
	IF:	Expr {getcharquadprop[6]>=1490000}
		DO:	DoAll
				ChatExpr {`/t `+getcharstringprop[1]+`, I am close to max luminance, so I am going to skip turn-in.`}
				SetState {Finished}
	IF:	Always
		DO:	DoAll
				ClearWatchdog
				SetOpt {EnableCombat} {False}
				SetOpt {EnableLooting} {False}
				SetOpt {EnableNav} {True}
				EmbedNav nav5__Falatacot_Depot___Turn_In_nav {Falatacot Depot - Turn In.nav}
	IF:	NavEmpty
		DO:	DoAll
				ChatExpr {`/ub opt set Networking.Tags remove FalatacotGroup`}
				SetState {Finished}
~~ }
STATE: {EquipEquipment} ~~ {
	IF:	Expr {testpvar[Trinkets]==0||@Trinkets{{TurnInTrinket}}==`NotSet`||@Trinkets{{DefaultTrinket}}==`NotSet`}
		DO:	Return
	IF:	Expr {$TurnInEquipment==1}
		DO:	ChatExpr {`/mt dequip `+@Trinkets{{DefaultTrinket}}}
	IF:	All
			Expr {$TurnInEquipment==1}
			SecsInStateGE 2
		DO:	DoAll
				ChatExpr {`/mt equip `+@Trinkets{{TurnInTrinket}}}
				DoExpr {$TurnInEquipment=2}
				Return
	IF:	Expr {$TurnInEquipment==2}
		DO:	ChatExpr {`/mt dequip `+@Trinkets{{TurnInTrinket}}}
	IF:	All
			Expr {$TurnInEquipment==2}
			SecsInStateGE 2
		DO:	DoAll
				ChatExpr {`/mt equip `+@Trinkets{{DefaultTrinket}}}
				DoExpr {$TurnInEquipment=0}
				Return
~~ }
STATE: {Finished} ~~ {
	IF:	Always
		DO:	DoAll
				ChatExpr {`/vt settings load `+getcharstringprop[1]+`TempBackup`}
	IF:	All
			Expr {getfellowshipisleader[]==1}
			Expr {&MetaQueueStart==1}
		DO:	DoAll
				DoExpr {&MetaStage=&MetaStage+1}
				DoExpr {cleargvar[RalliedChars]}
	IF:	SecsInStateGE 1
		DO:	DoAll
				EmbedNav nav6__NavToMansion_nav {NavToMansion.nav}
				SetOpt {EnableNav} {True}
	IF:	All
			SecsInStateGE 60
			Expr {&MetaQueueStart==1}
			NavEmpty
		DO:	ChatExpr {`/vt meta load MetaQ`}
~~ }
STATE: {Recover} ~~ {
	IF:	Always
		DO:	DoAll
				ChatExpr {`/vt settings load `+getcharstringprop[1]+`TempBackup`}
	IF:	Expr {getfellowshipisleader[]==1}
		DO:	ChatExpr {`/vt meta load MetaQAbort`}
	IF:	SecsInStateGE 1
		DO:	DoAll
				DoExpr {$RecoveryMode=1}
				ChatExpr {`/vt meta load MetaQ`}
~~ }


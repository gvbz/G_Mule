				SetOpt {EnableLooting} {False}
				SetOpt {EnableNav} {True}
	IF:	All
			NavEmpty
			Expr {getfellowshipisleader[]==1}
		DO:	DoAll
				EmbedNav nav3__Virindi_Rescue___Rescue_nav {Virindi Rescue - Rescue.nav}
				SetState {Virindi Rescue}
	IF:	All
			NavEmpty
			Expr {getfellowshipisleader[]==0}
		DO:	DoAll
				EmbedNav nav4__Virindi_Rescue___Rescue_nav {Virindi Rescue - Rescue.nav}
				SetState {Virindi Rescue}
	IF:	Death
		DO:	SetState {Recover}
~~ }
STATE: {Virindi Rescue} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableBuffing} {False}
				SetOpt {EnableCombat} {True}
				SetOpt {EnableLooting} {True}
	IF:	SecsInStateGE 3
		DO:	SetOpt {EnableNav} {True}
	IF:	NavEmpty
		DO:	DoAll
				EmbedNav nav5___None_ {[none]}
				SetOpt {EnableLooting} {False}
	IF:	All
			Expr {$LootStatus==0}
			Expr {getfellowshipisleader[]==1}
			Expr {wobjectfindnearestbynameandobjectclass[27, listgetitem[$CorpseNames,$LootStage]]!=0}
			Expr {coordinatedistancewithz[getplayercoordinates[], wobjectgetphysicscoordinates[wobjectfindnearestbynameandobjectclass[27, listgetitem[$CorpseNames,$LootStage]]]]<=20}
		DO:	DoAll
				SetOpt {EnableLooting} {False}
				SetState {Looting}
	IF:	ItemCountGE 1 {Essence of Dravann}
		DO:	DoAll
				Chat {/ub close corpse}
				SetState {Completion}
	IF:	Death
		DO:	SetState {Recover}
~~ }
STATE: {VirindiCaptive} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableBuffing} {False}
				SetOpt {EnableCombat} {False}
				SetOpt {EnableLooting} {False}
				SetOpt {EnableNav} {False}
				DoExpr {setvar[Timer, stopwatchcreate[]];stopwatchstart[getvar[Timer]]}
	IF:	Expr {stopwatchelapsedseconds[getvar[Timer]]>=getvar[RandomInt]}
		DO:	DoAll
				DoExpr {actiontryuseitem[wobjectfindnearestbyobjectclass[37]]}
				SetState {VirindiCaptive}
	IF:	Any
			ChatMatch {The Virindi pauses}
			ChatMatch {The Virindi looks at you}
			ChatMatch {A strange sound eminates}
		DO:	SetState {Virindi Rescue}
	IF:	Death
		DO:	SetState {Recover}
~~ }
STATE: {DoorWait} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableBuffing} {False}
				SetOpt {EnableCombat} {True}
				SetOpt {EnableLooting} {True}
				SetOpt {EnableNav} {False}
	IF:	Expr {wobjectgetisdooropen[wobjectfindnearestdoor[]]==1}
		DO:	SetState {Virindi Rescue}
	IF:	Expr {getfellowshipisleader[]==1}
		DO:	DoAll
				DoExpr {actiontryapplyitem[wobjectfindininventorybyname[Virindi Prison Key], wobjectfindnearestdoor[]}
				Chat {/ub uselp Cell Door}
				SetState {DoorWait}
	IF:	Death
		DO:	SetState {Recover}
~~ }
STATE: {Looting} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableNav} {False}
				SetOpt {EnableCombat} {False}
				SetOpt {EnableLooting} {False}
				ChatExpr {`/ub uselp `+listgetitem[$CorpseNames,$LootStage]}
	IF:	SecsInStateGE 8
		DO:	DoAll
				ChatExpr {`/mt lootp `+listgetitem[$ItemNames,$LootStage]}
	IF:	SecsInStateGE 12
		DO:	SetState {Looting}
	IF:	Expr {wobjectfindininventorybyname[listgetitem[$ItemNames,$LootStage]]!=0}
		DO:	DoAll
				DoExpr {setvar[LootStatus, 1]}
				SetState {Virindi Rescue}
	IF:	Death
		DO:	SetState {Recover}
~~ }
STATE: {Finished} ~~ {
	IF:	Always
		DO:	DoAll
				ChatExpr {`/vt settings load `+getcharstringprop[1]+`TempBackup`}
	IF:	All
			Expr {getfellowshipisleader[]==1}
			Expr {&MetaQueueStart==1}
		DO:	DoAll
				DoExpr {&MetaStage=&MetaStage+1}
				DoExpr {cleargvar[RalliedChars]}
	IF:	SecsInStateGE 1
		DO:	DoAll
				EmbedNav nav6__NavToMansion_nav {NavToMansion.nav}
				SetOpt {EnableNav} {True}
	IF:	All
			SecsInStateGE 60
			Expr {&MetaQueueStart==1}
			NavEmpty
		DO:	ChatExpr {`/vt meta load MetaQ`}
~~ }
STATE: {Recover} ~~ {
	IF:	Always
		DO:	DoAll
				ChatExpr {`/vt settings load `+getcharstringprop[1]+`TempBackup`}
	IF:	Expr {getfellowshipisleader[]==1}
		DO:	ChatExpr {`/vt meta load MetaQAbort`}
	IF:	SecsInStateGE 1
		DO:	DoAll
				DoExpr {$RecoveryMode=1}
				ChatExpr {`/vt meta load MetaQ`}
~~ }


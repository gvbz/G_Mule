STATE: {***Setup***} ~~ {
	IF:	Always
		DO:	DoAll
				DoExpr {$NexusTies=dictcreate[`Jiggi-Mage`,`Secondary`,`Magical Mike`,`Secondary`]}
				DoExpr {$LootProfile=`Farming.utl`}
				DoExpr {$KeyMuleNavOrMeta=`meta`}
				DoExpr {$KeyMuleProfileName=`Key Muling`}
				DoExpr {$ReCompNavProfile=`ReComp - Celdiseth`}
	IF:	ChatMatch {   %%% DO NOT EDIT BELOW THIS LINE %%%}
		DO:	None
	IF:	Expr {$FirstStart==0}
		DO:	DoAll
				DoExpr {setvar[QuestList, listcreate[Virindi Rescue,Apostate Finale,Nexus Crawl,Falatacot Depot,Lost City of Neftet,Frozen Valley,Tou Tou Kill Tasks,Graveyard Kill Tasks,Rynthid Kill Tasks,Lugian Assault,Bloodstone Investigation Flagging,Bloodstone Factory,ReComp,Key Muling]]}
				DoExpr {$AutoStart=0}
				DoExpr {touchpvar[BloodstoneWandForLum]}
				ChatExpr {`/vt settings save `+getcharstringprop[1]+`TempBackup`}
				DoExpr {$FirstStart=1}
	IF:	Any
			Expr {&MetaLeader==getcharstringprop[1]}
			Expr {testgvar[MetaLeader]==0}
		DO:	DoAll
				DoExpr {&MetaLeader=getcharstringprop[1]}
				ChatExpr {`/me will be the Meta Leader.`}
				DoExpr {&MetaStage=0}
				DoExpr {&BloodstoneTurnInFlag=0}
	IF:	All
			Expr {testgvar[MetaQueue]==0}
			Expr {&MetaLeader==getcharstringprop[1]}
		DO:	DoExpr {setgvar[MetaQueue,listcreate[]]}
	IF:	SecsInStateGE 2
		DO:	DoAll
				ChatExpr {`/t `+getcharstringprop[1]+`, is ready to get all meta up in here!`}
				SetState {Default}
~~ }
STATE: {Default} ~~ {
	IF:	Always
		DO:	Chat {/ub opt set VTank.PatchExpressionEngine true}
	IF:	Expr {$RecoveryMode==1}
		DO:	SetState {Recover}
	IF:	Expr {$FirstStart==0}
		DO:	DoAll
				SetOpt {EnableNav} {False}
				DoExpr {echo[`[MetaQ] Welcome to Jiggi's MetaQ! Use of the Chaos Helper with MetaQ UI is strongly recommended.`,31]}
				SetState {***Setup***}
	IF:	Expr {testpvar[Trinkets]==0||@Trinkets{{TurnInTrinket}}==`NotSet`||@Trinkets{{DefaultTrinket}}==`NotSet`}
		DO:	DoExpr {echo[`[MetaQ] WARNING - Either a turn-in or default trinket has not been set for this character. To use this functionality, please select the trinket and use the buttons in Chaos Helper.`,5]}
	IF:	All
			Expr {$FirstStart==1}
			Expr {&MetaLeader==getcharstringprop[1]}
		DO:	SetState {Leader}
	IF:	All
			Expr {$FirstStart==1}
			Expr {&MetaLeader!=getcharstringprop[1]}
		DO:	SetState {Team}
~~ }
STATE: {Leader} ~~ {
	IF:	Always
		DO:	DoAll
				DoExpr {echo[`[MetaQ] For a list of available commands, type '[hashtag]meta help' or use the Chaos Helper UI`,31]}
	IF:	ChatMatch {#meta help}
		DO:	DoAll
				DoExpr {echo[`[MetaQ] Commands are issued with #meta [command] and are case sensitive.`,31]}
				DoExpr {echo[`[MetaQ] Available commands are: set queue,set group,set leader [name],startgroup,autostart [on/off],startnext,stop,resetvtprofile,call home,restart queue`,31]}
	IF:	ChatMatch {#meta set queue}
		DO:	SetState {SetQueue}
	IF:	ChatMatch {#meta set group}
		DO:	SetState {SetGroup}
	IF:	ChatMatch {#meta startgroup}
		DO:	SetState {Startup}
	IF:	ChatCapture {(^(\[[A-z]+?\] |)You|.*\<Tell:IIDString:.+:(?<name>[^\<]*)\>.+\<\\Tell\>) (?<saythink>.*), \"#meta autostart (?<autostartopt>.*)?"$} {}
		DO:	SetState {SetAutoStart}
	IF:	ChatMatch {#meta restart queue}
		DO:	SetState {RestartQueue}
	IF:	ChatMatch {#meta resetvtprofiles}
		DO:	SetState {ResetVTProfiles}
	IF:	ChatMatch {#meta startnext}
		DO:	SetState {MetaExecution}
	IF:	ChatMatch {#meta stop}
		DO:	SetState {ShutDown}
	IF:	ChatCapture {(^(\[[A-z]+?\] |)You|.*\<Tell:IIDString:.+:(?<name>[^\<]*)\>.+\<\\Tell\>) (?<saythink>.*), \"#meta set leader (?<newleader>.*)?"$} {}
		DO:	SetState {ChangeLeader}
	IF:	All
			Expr {listcount[&MetaQueue]>0}
			Expr {&MetaStage>=listcount[&MetaQueue]}
		DO:	DoAll
				DoExpr {echo[`[MetaQ] MetaQ is complete! Initiating automatic group shutdown`,31]}
				SetState {ShutDown}
	IF:	All
			Expr {&MetaLeader==getcharstringprop[1]}
			Expr {$AutoStart==1}
			Expr {listcount[&MetaQueue]!=0}
		DO:	DoExpr {echo[`[MetaQ] I will be starting the following meta in 2 minutes: `+listgetitem[&MetaQueue,&MetaStage],31]}
	IF:	All
			Expr {&MetaLeader==getcharstringprop[1]}
			Expr {$AutoStart==0}
			Expr {listcount[&MetaQueue]!=0}
		DO:	DoExpr {echo[`[MetaQ] The `+listgetitem[&MetaQueue,&MetaStage]+` meta is queued up. To start, use the 'start next' command or Chaos Helper controls`,31]}
	IF:	Expr {listcount[&MetaQueue]==0}
		DO:	DoAll
				DoExpr {echo[`[MetaQ] No metas have been added to the queue. Please configure the queue before proceeding.`,15]}
	IF:	All
			SecsInStateGE 120
			Expr {$AutoStart==1}
			Expr {listcount[&MetaQueue]!=0}
		DO:	DoAll
				SetState {MetaExecution}
	IF:	ChatMatch {#meta set selected leader}
		DO:	SetState {ChangeLeader}
~~ }
STATE: {Team} ~~ {
	IF:	Always
		DO:	DoAll
				ChatExpr {`/me is ready and waiting for orders.`}
	IF:	Expr {&MetaLeader==getcharstringprop[1]}
		DO:	SetState {Default}
~~ }
STATE: {ChangeLeader} ~~ {
	IF:	Expr {wobjectgetobjectclass[wobjectgetselection[]]==24}
		DO:	DoAll
				DoExpr {&MetaLeader=wobjectgetstringprop[wobjectgetselection[],1]}
				ChatExpr {`/ub fellow leader `+&MetaLeader}
				SetState {Default}
	IF:	Expr {checkvar[capturegroup_newleader]==0}
		DO:	DoAll
				DoExpr {echo[`[MetaQ] You need to provide a valid, logged in, and nearby character name to set a new leader.`,15]}
				SetState {Default}
	IF:	Expr {wobjectfindnearestbynameandobjectclass[24, $capturegroup_newleader]==0}
		DO:	DoAll
				DoExpr {echo[`[MetaQ] That character does not exist, or is not in range.`,15]}
				SetState {Default}
	IF:	All
			Expr {&MetaLeader==getcharstringprop[1]}
			Expr {checkvar[capturegroup_newleader]==1}
			Expr {wobjectfindnearestbynameandobjectclass[24, $capturegroup_newleader]!=0}
		DO:	DoAll
				DoExpr {&MetaLeader=$capturegroup_newleader}
				ChatExpr {`/ub fellow leader `+&MetaLeader}
				DoExpr {echo[`[MetaQ] Successfully set leader to `+&MetaLeader,31]}
				SetState {Default}
~~ }
STATE: {SetAutoStart} ~~ {
	IF:	Expr {$capturegroup_autostartopt==`on`}
		DO:	DoAll
				DoExpr {$AutoStart=1}
				ChatExpr {`/ub bct MetaBuddies /ub mexec setvar[AutoStart,1]`}
				DoExpr {echo[`[MetaQ] Autostart enabled`,31]}
				SetState {Default}
	IF:	Expr {$capturegroup_autostartopt==`off`}
		DO:	DoAll
				DoExpr {$AutoStart=0}
				ChatExpr {`/ub bct MetaBuddies /ub mexec setvar[AutoStart,0]`}
				DoExpr {echo[`[MetaQ] Autostart disabled`,31]}
				SetState {Default}
~~ }
STATE: {Startup} ~~ {
	IF:	Expr {testgvar[MetaQueue]==0||testgvar[GroupList]==0||getfellowshipstatus[]==0||getfellowshipcount[]!=listcount[&GroupList]+1}
		DO:	DoAll
				DoExpr {echo[`[MetaQ] Conditions to start have not been met. Please ensure you have set the queue, set your group, and created a fellowship with ALL members of the group.`,15]}
				SetState {Default}
	IF:	Always
		DO:	DoAll
				DoExpr {echo[`[MetaQ] Starting group, please wait...`,31]}
				Chat {/ub bct MetaBuddies 500 /vt meta load MetaQ}
	IF:	SecsInStateGE 3
		DO:	Chat {/ub bct MetaBuddies /vt opt set EnableMeta True}
	IF:	SecsInStateGE 5
		DO:	DoAll
				Chat {/ub bct MetaBuddies 100 /vt start}
				DoExpr {echo[`[MetaQ] Group successfully started`,31]}
				SetState {Default}
~~ }
STATE: {ShutDown} ~~ {
	IF:	Expr {&MetaLeader!=getcharstringprop[1]}
		DO:	DoAll
				DoExpr {echo[`[MetaQ] I do not have the authority to shut down this group]`,15}
				SetState {Default}
	IF:	Expr {&MetaLeader==getcharstringprop[1]}
		DO:	DoExpr {echo[`[MetaQ] Initiating shut down routine. Press cancel to abort.`,31]}
	IF:	All
			Expr {&MetaLeader==getcharstringprop[1]}
			SecsInStateGE 10
		DO:	DoAll
				DoExpr {$FirstStart=0}
				DoExpr {&MetaStage=0}
				DoExpr {&MetaQueueStart=0}
				DoExpr {echo[`[MetaQ] Shut down complete. We know you have a choice in meta providers, thank you for choosing Jiggiwatt's Discount Metas.`,31]}
	IF:	All
			Expr {&MetaLeader==getcharstringprop[1]&&&LogOffComplete==1}
			SecsInStateGE 11
		DO:	DoAll
				ChatExpr {`/ub bct MetaBuddies /vt setmetastate LogOff`}
				ChatExpr {`/ub bct MetaBuddies /ub mexec setvar[FirstStart,0]`}
				ChatExpr {`/ub bct MetaBuddies 100 /ub opt set Networking.Tags remove MetaBuddies`}
				SetState {LogOff}
	IF:	All
			Expr {&MetaLeader==getcharstringprop[1]&&&LogOffComplete==0}
			SecsInStateGE 11
		DO:	DoAll
				ChatExpr {`/ub bct MetaBuddies /vt stop`}
				ChatExpr {`/ub bct MetaBuddies /ub mexec setvar[FirstStart,0]`}
				ChatExpr {`/ub bct MetaBuddies 100 /ub opt set Networking.Tags remove MetaBuddies`}
				ChatExpr {`/vt stop`}
	IF:	All
			SecsInStateGE 1
			ChatMatch {#cancel}
		DO:	SetState {Default}
~~ }
STATE: {SetGroup} ~~ {
	IF:	Always
		DO:	DoAll
				DoExpr {echo[`[MetaQ] Defining group and creating Fellowship, please stand by`,31]}
				ChatExpr {`/ub bc /ub opt set Networking.Tags add MetaBuddies`}
				ChatExpr {`/ub fellow create Derp Patrol`}
	IF:	SecsInStateGE 2
		DO:	ChatExpr {`/ub opt set Networking.Tags remove MetaBuddies`}
	IF:	SecsInStateGE 3
		DO:	DoExpr {&GroupList=listmap[netclients[MetaBuddies],`$1{{Name}}`]}
	IF:	SecsInStateGE 4
		DO:	DoAll
				ChatExpr {`/ub fellow recruit `+listgetitem[&GroupList,0]}
				ChatExpr {`/ub fellow recruit `+listgetitem[&GroupList,1]}
				ChatExpr {`/ub fellow recruit `+listgetitem[&GroupList,2]}
				ChatExpr {`/ub fellow recruit `+listgetitem[&GroupList,3]}
				ChatExpr {`/ub fellow recruit `+listgetitem[&GroupList,4]}
				ChatExpr {`/ub fellow recruit `+listgetitem[&GroupList,5]}
				ChatExpr {`/ub fellow recruit `+listgetitem[&GroupList,6]}
				ChatExpr {`/ub fellow recruit `+listgetitem[&GroupList,7]}
				ChatExpr {`/ub fellow recruit `+listgetitem[&GroupList,8]}
				DoExpr {echo[`[MetaQ] Group successfully created.`,31]}
				SetState {Default}
~~ }
STATE: {SetQueue} ~~ {
	IF:	Expr {testgvar[MetaQueue]==0}
		DO:	DoExpr {setgvar[MetaQueue, listcreate[]]}
	IF:	Expr {$MenuStarted==0}
		DO:	DoAll
				DoExpr {echo[`[MetaQ] Starting Queue Config. Commands are issued with #meta [command]. Available commands:`,31]}
				DoExpr {echo[`[MetaQ] list - to view a list of available metas`,31]}
				DoExpr {echo[`[MetaQ] queue check - to view the current meta queue`,31]}
				DoExpr {echo[`[MetaQ] queue add [name] - to add a quest to the meta queue`,31]}
				DoExpr {echo[`[MetaQ] queue clear - to reset the meta queue`,31]}
				DoExpr {echo[`[MetaQ] queue exit - to leave the queue setup`,31]}
				DoExpr {echo[`[MetaQ] queue startposition [number] - Set the start position for the queue (default is 0)`,31]}
				DoExpr {$MenuStarted=1}
				SetState {SetQueue}
	IF:	ChatMatch {#meta list}
		DO:	DoAll
				DoExpr {echo[`[MetaQ] Available Metas are:`,31]}
				DoExpr {echo[`[MetaQ] 1. `+listgetitem[$QuestList,0],31]}
				DoExpr {echo[`[MetaQ] 2. `+listgetitem[$QuestList,1],31]}
				DoExpr {echo[`[MetaQ] 3. `+listgetitem[$QuestList,2],31]}
				DoExpr {echo[`[MetaQ] 4. `+listgetitem[$QuestList,3],31]}
				DoExpr {echo[`[MetaQ] 5. `+listgetitem[$QuestList,4],31]}
				DoExpr {echo[`[MetaQ] 6. `+listgetitem[$QuestList,5],31]}
				DoExpr {echo[`[MetaQ] 7. `+listgetitem[$QuestList,6],31]}
				DoExpr {echo[`[MetaQ] 8. `+listgetitem[$QuestList,7],31]}
				DoExpr {echo[`[MetaQ] 9. `+listgetitem[$QuestList,8],31]}
				DoExpr {echo[`[MetaQ] 10. `+listgetitem[$QuestList,9],31]}
				SetState {SetQueue}
	IF:	ChatMatch {#meta queue check}
		DO:	DoAll
				DoExpr {echo[`[MetaQ] The current meta queue is: `+&MetaQueue,31]}
				SetState {SetQueue}
	IF:	ChatCapture {(^(\[[A-z]+?\] |)You|.*\<Tell:IIDString:.+:(?<name>[^\<]*)\>.+\<\\Tell\>) (?<saythink>.*), \"#meta queue add (?<metaitemt>.*)?"$} {}
		DO:	DoAll
				DoExpr {ifthen[listcontains[&QuestList,$capturegroup_metaitem]==1,`listadd[&MetaQueue,$capturegroup_metaitem]`,`That meta is not available. Please note metas are case sensitive.`]}
				SetState {SetQueue}
	IF:	ChatMatch {#meta queue clear}
		DO:	DoAll
				DoExpr {cleargvar[MetaQueue]}
				SetState {SetQueue}
	IF:	ChatMatch {#meta queue exit}
		DO:	DoAll
				DoExpr {$MenuStarted=0}
				SetState {Default}
	IF:	ChatCapture {(^(\[[A-z]+?\] |)You|.*\<Tell:IIDString:.+:(?<name>[^\<]*)\>.+\<\\Tell\>) (?<saythink>.*), \"#meta queue startposition (?<StartPosition>\d+)?"$} {}
		DO:	DoAll
				DoExpr {ifthen[capturegroup_StartPosition<listcount[&MetaQueue],&MetaStage=$capturegroup_StartPosition,echo[Invalid Queue Position,15]}
				DoExpr {echo[`[MetaQ] Queue start position set to `+&MetaStage+` (`+listgetitem[&MetaQueue,&MetaStage]+`)`,31]}
				SetState {SetQueue}
	IF:	ChatMatch {#meta queue increment}
		DO:	DoAll
				DoExpr {ifthen[(&MetaStage+1)<listcount[&MetaQueue],`&MetaStage=&MetaStage+1`,`echo[Maximum Queue Position Reached,15]`]}
				DoExpr {echo[`[MetaQ] Queue start position set to `+&MetaStage+` (`+listgetitem[&MetaQueue,&MetaStage]+`)`,31]}
				SetState {SetQueue}
	IF:	ChatMatch {#meta queue decrement}
		DO:	DoAll
				DoExpr {ifthen[&MetaStage==0,`echo[Minimum Queue Position Reached,15]`,`&MetaStage=&MetaStage-1`]}
				DoExpr {echo[`[MetaQ] Queue start position set to `+&MetaStage+` (`+listgetitem[&MetaQueue,&MetaStage]+`)`,31]}
				SetState {SetQueue}
~~ }
STATE: {Reset} ~~ {
	IF:	Expr {&MetaLeader==getcharstringprop[1]}
		DO:	DoAll
				DoExpr {echo[`[MetaQ] WARNING - Resetting all settings and group members, and restarting the meta queue. Say '[hashtag]cancel' to cancel`,31]}
	IF:	All
			SecsInStateGE 1
			ChatMatch {#cancel}
		DO:	SetState {Default}
	IF:	All
			Expr {&MetaLeader==getcharstringprop[1]}
			SecsInStateGE 10
		DO:	DoAll
				DoExpr {$FirstStart=0}
				DoExpr {$AutoStart=1}
				DoExpr {&MetaStage=0}
				DoExpr {&MetaQueueStart=0}
				Chat {/ub bct MetaBuddies /vt setmetastate Reset}
				DoExpr {echo[`[MetaQ] Reset complete.`,31]}
				SetState {Default}
	IF:	All
			Expr {&MetaLeader!=getcharstringprop[1]}
			SecsInStateGE 1
		DO:	DoAll
				DoExpr {echo[`[MetaQ] Resetting all personal settings and restarting this character.`,31]}
				DoExpr {$FirstStart=0}
				DoExpr {$AutoStart=0}
				DoExpr {echo[`[MetaQ] Character Reset complete.`,31]}
				SetState {Default}
~~ }
STATE: {ResetVTProfile} ~~ {
	IF:	Expr {&MetaLeader==getcharstringprop[1]}
		DO:	DoAll
				ChatExpr {`/ub bct MetaBuddies 300 /vt setmetastate ResetVTProfile`}
				DoExpr {echo[`[MetaQ] Reset VT profiles complete. Note that this will only impact group members currently running the MetaQ meta.`,31]}
				ChatExpr {`/vt settings load `+getcharstringprop[1]+`TempBackup`}
	IF:	Always
		DO:	DoAll
				ChatExpr {`/vt settings load `+getcharstringprop[1]+`TempBackup`}
				SetState {Default}
~~ }
STATE: {RestartQueue} ~~ {
	IF:	Expr {&MetaLeader==getcharstringprop[1]}
		DO:	DoAll
				DoExpr {&MetaStage=0}
				DoExpr {echo[`[MetaQ] MetaQ has been reset to position 0 (first meta in queue).`,15]}
				SetState {Default}
	IF:	SecsInStateGE 5
		DO:	SetState {Default}
~~ }
STATE: {MetaExecution} ~~ {
	IF:	Expr {listcount[&MetaQueue]==0}
		DO:	SetState {Leader}
	IF:	Expr {listgetitem[&MetaQueue,&MetaStage]==`Key Muling`}
		DO:	SetState {KeyMuling}
	IF:	Expr {listgetitem[&MetaQueue,&MetaStage]==`ReComp`}
		DO:	SetState {ReComp}
	IF:	Always
		DO:	DoExpr {echo[`[MetaQ] Starting the next meta in 10 seconds, please stand by.`,31]}
	IF:	All
			SecsInStateGE 10
			Expr {&MetaLeader==getcharstringprop[1]}
			Expr {&MetaStage<listcount[&MetaQueue]}
		DO:	DoAll
				DoExpr {&MetaQueueStart=1}
				ChatExpr {`/ub bct MetaBuddies 500 /vt meta load `+listgetitem[&MetaQueue,&MetaStage]}
				ChatExpr {`/vt meta load `+listgetitem[&MetaQueue,&MetaStage]}
	IF:	All
			SecsInStateGE 1
			ChatMatch {#cancel}
		DO:	SetState {Default}
	IF:	Expr {&MetaStage>=listcount[&MetaQueue]}
		DO:	DoAll
				DoExpr {echo[`[MetaQ] MetaQ is complete! Initiating automatic group shutdown`,31]}
				SetState {ShutDown}
~~ }
STATE: {KeyMuling} ~~ {
	IF:	Expr {&MetaLeader==getcharstringprop[1]}
		DO:	DoAll
				DoExpr {&MetaStage=&MetaStage+1}
				ChatExpr {`/ub bct MetaBuddies /vt setmetastate KeyMuling`}
				DoExpr {echo[`[MetaQ] Initiating Key Muling, MetaQ will resume on completion`,31]}
	IF:	Expr {$KeyMuleNavOrMeta==`nav`}
		DO:	DoAll
				ChatExpr {`/vt nav load `+$KeyMuleProfileName}
				SetOpt {EnableNav} {True}
	IF:	Expr {$KeyMuleNavOrMeta==`meta`}
		DO:	ChatExpr {`/vt meta load `+$KeyMuleProfileName}
	IF:	All
			Expr {&MetaLeader==getcharstringprop[1]}
			ChatMatch {#cancel}
		DO:	DoAll
				ChatExpr {`/ub bct MetaBuddies 500 /vt setmetastate Default`}
				SetState {Default}
	IF:	All
			SecsInStateGE 5
			NavEmpty
		DO:	SetState {Default}
~~ }
STATE: {ReComp} ~~ {
	IF:	Expr {&MetaLeader==getcharstringprop[1]}
		DO:	DoAll
				DoExpr {&MetaStage=&MetaStage+1}
				ChatExpr {`/ub bct MetaBuddies /vt setmetastate ReComp`}
				DoExpr {echo[`[MetaQ] Initiating Recomp, Meta Q will resume on completion.`,31]}
	IF:	Always
		DO:	DoAll
				ChatExpr {`/vt nav load `+$ReCompNavProfile}
				SetOpt {EnableNav} {True}
	IF:	All
			Expr {&MetaLeader==getcharstringprop[1]}
			ChatMatch {#cancel}
		DO:	DoAll
				ChatExpr {`/ub bct MetaBuddies 500 /vt setmetastate Default`}
				SetState {Default}
	IF:	All
			SecsInStateGE 5
			NavEmpty
		DO:	SetState {Default}
~~ }
STATE: {SetTurnInEquipment} ~~ {
	IF:	Expr {testpvar[Trinkets]==0}
		DO:	DoExpr {@Trinkets=dictcreate[`TurnInTrinket`,`NotSet`,`DefaultTrinket`,`NotSet`]}
	IF:	Always
		DO:	DoAll
				DoExpr {dictadditem[@Trinkets,`TurnInTrinket`,wobjectgetstringprop[wobjectgetselection[],1]]}
				DoExpr {echo[`[MetaQ] Turn-in Trinket set to: `+@Trinkets{{TurnInTrinket}},31]}
				SetState {Default}
~~ }
STATE: {SetDefaultEquipment} ~~ {
	IF:	Expr {testpvar[Trinkets]==0}
		DO:	DoExpr {@Trinkets=dictcreate[`TurnInTrinket`,`NotSet`,`DefaultTrinket`,`NotSet`]}
	IF:	Always
		DO:	DoAll
				DoExpr {dictadditem[@Trinkets,`DefaultTrinket`,wobjectgetstringprop[wobjectgetselection[],1]]}
				DoExpr {echo[`[MetaQ] Default Trinket set to: `+@Trinkets{{DefaultTrinket}},31]}
				SetState {Default}
~~ }
STATE: {ClearEquipment} ~~ {
	IF:	Always
		DO:	DoAll
				DoExpr {@Trinkets=dictcreate[`TurnInTrinket`,`NotSet`,`DefaultTrinket`,`NotSet`]}
				DoExpr {echo[`[MetaQ] Trinket settings cleared.`,31]}
				SetState {Default}
~~ }
STATE: {EquipEquipment} ~~ {
	IF:	Expr {testpvar[Trinkets]==0||@Trinkets{{TurnInTrinket}}==`NotSet`||@Trinkets{{DefaultTrinket}}==`NotSet`}
		DO:	DoAll
				DoExpr {echo[`[MetaQ] Turn-in or default trinket has not been set for this character. Please ensure you are running MetaQ, select the desired trinket, and use the appropriate buttons in Chaos Helper.`,15]}
	IF:	Always
		DO:	ChatExpr {`/mt dequip `+@Trinkets{{DefaultTrinket}}}
	IF:	SecsInStateGE 2
		DO:	DoAll
				ChatExpr {`/mt equip `+@Trinkets{{TurnInTrinket}}}
				SetState {Default}
~~ }
STATE: {BloodstoneOption1} ~~ {
	IF:	Expr {&MetaLeader!=getcharstringprop[1]}
		DO:	DoAll
				DoExpr {echo[`[MetaQ] This is a team setting and can only be set by the leader]`,15}
				SetState {Team}
	IF:	All
			Expr {&MetaLeader==getcharstringprop[1]}
			Expr {&BloodstoneTurnInFlag==0}
		DO:	DoAll
				DoExpr {&BloodstoneTurnInFlag=1}
				DoExpr {echo[`[MetaQ] Bloodstone Factory turn-in ENABLED`,5]}
				SetState {Leader}
	IF:	All
			Expr {&MetaLeader==getcharstringprop[1]}
			Expr {&BloodstoneTurnInFlag==1}
		DO:	DoAll
				DoExpr {&BloodstoneTurnInFlag=0}
				DoExpr {echo[`[MetaQ] Bloodstone Factory turn-in DISABLED`,5]}
				SetState {Leader}
~~ }
STATE: {BloodstoneOption2} ~~ {
	IF:	Expr {@BloodstoneWandForLum==0}
		DO:	DoAll
				DoExpr {@BloodstoneWandForLum=1}
				DoExpr {echo[`[MetaQ] This character will automatically turn-in the Bloodstone wands for luminance when running the Bloodstone Factory meta`,5]}
				SetState {Default}
	IF:	Expr {@BloodstoneWandForLum==1}
		DO:	DoAll
				DoExpr {@BloodstoneWandForLum=0}
				DoExpr {echo[`[MetaQ] This character will NOT turn-in the Bloodstone wands for luminance when running the Bloodstone Factory meta`,5]}
				SetState {Default}
~~ }
STATE: {LogOff} ~~ {
	IF:	Expr {&LogOffComplete==0}
		DO:	DoAll
				DoExpr {echo[`[MetaQ] Unable to logout. Please enable automatic logout in the MetaQ options.`,15]}
				SetState {Default}
	IF:	Expr {&LogOffComplete==1}
		DO:	DoExpr {echo[`[MetaQ] Automatically logging out in 3 minutes. Click the 'cancel' button to abort.`,5]}
	IF:	All
			Expr {&LogOffComplete==1}
			SecsInStateGE 180
		DO:	ChatExpr {`/mt logout`}
~~ }
STATE: {Recover} ~~ {
	IF:	Always
		DO:	DoAll
				ChatExpr {`/vt settings load `+getcharstringprop[1]+`TempBackup`}
	IF:	Expr {getfellowshipisleader[]==1}
		DO:	ChatExpr {`/vt meta load MetaQAbort`}
	IF:	SecsInStateGE 1
		DO:	DoAll
				EmbedNav nav0__NavToMansion_nav {NavToMansion.nav}
				SetOpt {EnableNav} {True}
	IF:	NavEmpty
		DO:	Chat {/ub fellow quit}
	IF:	All
			NavEmpty
			Expr {wobjectfindnearestbynameandobjectclass[24,$LeaderName]!=0}
			Expr {coordinatedistancewithz[getplayercoordinates[], wobjectgetphysicscoordinates[wobjectfindnearestbynameandobjectclass[24,$LeaderName]]]<=10}
		DO:	DoAll
				ChatExpr {`/t `+$LeaderName+`, xp`}
				DoExpr {$RecoveryMode=0}
				SetState {Default}
~~ }


				SetOpt {EnableLooting} {False}
				SetOpt {EnableNav} {True}
				SetWatchdog 5 120 {Flagging}
	IF:	NavEmpty
		DO:	SetState {Rally}
~~ }
STATE: {Fighting} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableBuffing} {True}
				SetOpt {EnableCombat} {True}
				SetOpt {EnableLooting} {True}
	IF:	Expr {getfellowshipisleader[]==1}
		DO:	EmbedNav nav1__Frozen_Valley___Short_Patrol_nav {Frozen Valley - Short Patrol.nav}
	IF:	Expr {getfellowshipisleader[]==0}
		DO:	ChatExpr {`/ub follow `+getvar[LeaderName]}
	IF:	SecsInStateGE 1
		DO:	SetOpt {EnableNav} {True}
	IF:	All
			Expr {getfellowshipisleader[]==1}
			SecsInStateGE 10
		DO:	DoExpr {cleargvar[RalliedChars]}
	IF:	All
			Expr {getvar[TaskGurogMinion]==1}
			Expr {getvar[TaskGurogSoldier]==1}
			Expr {getvar[TaskGurogHenchmen]==1}
			Expr {getvar[TaskSnowTusker]==1}
			Expr {getvar[TaskSnowTuskerWarrior]==1}
			Expr {getvar[TaskSnowTuskerLeader]==1}
			Expr {getvar[TaskFrostGolem]==1}
			Expr {getvar[TaskFrozenWight]==1}
			Expr {getvar[TaskFrozenDread]==1}
			Expr {getvar[TaskFrozenCrystal]==1}
			Expr {getvar[TaskSnowTuskerBlood]==1}
		DO:	SetState {Completion}
	IF:	ChatMatch {Cheese it, it's the fuzz!}
		DO:	SetState {Completion}
	IF:	ChatMatch {You have killed 20 Gurog Minions}
		DO:	DoExpr {setvar[TaskGurogMinion, 1]}
	IF:	ChatMatch {You have killed 20 Gurog Soldiers}
		DO:	DoExpr {setvar[TaskGurogSoldier, 1]}
	IF:	ChatMatch {You have killed 20 Gurog Henchman}
		DO:	DoExpr {setvar[TaskGurogHenchmen, 1]}
	IF:	ChatMatch {You have killed 20 Snow Tuskers}
		DO:	DoExpr {setvar[TaskSnowTusker, 1]}
	IF:	ChatMatch {You have killed 20 Snow Tusker Warriors}
		DO:	DoExpr {setvar[TaskSnowTuskerWarrior, 1]}
	IF:	ChatMatch {You have killed 20 Snow Tusker Warriors}
		DO:	DoExpr {setvar[TaskSnowTuskerLeader, 1]}
	IF:	ChatMatch {You have killed 20 Frost Golems}
		DO:	DoExpr {setvar[TaskFrostGolem, 1]}
	IF:	ChatMatch {You have killed 20 Frozen Wight}
		DO:	DoExpr {setvar[TaskFrozenWight, 1]}
	IF:	ChatMatch {You have killed 10 Frozen Dread}
		DO:	DoExpr {setvar[TaskFrozenDread, 1]}
	IF:	ChatMatch {You have killed 4 Frozen Crystals}
		DO:	DoExpr {setvar[TaskFrozenCrystal, 1]}
	IF:	ItemCountGE 10 {Snow Tusker Blood Sample}
		DO:	DoExpr {setvar[TaskSnowTuskerBlood, 1]}
	IF:	Death
		DO:	SetState {Return on Death}
~~ }
STATE: {Return on Death} ~~ {
	IF:	Always
		DO:	DoAll
				EmbedNav nav2__Frozen_Valley___Return_nav {Frozen Valley - Return.nav}
				SetOpt {EnableNav} {True}
				SetOpt {EnableBuffing} {True}
	IF:	NavEmpty
		DO:	SetState {Fighting}
~~ }
STATE: {Completion} ~~ {
	IF:	Expr {$TurnInEquipment==1}
		DO:	CallState {EquipEquipment} {Completion}
	IF:	Expr {getcharquadprop[6]>=1490000}
		DO:	DoAll
				ChatExpr {`/t `+getcharstringprop[1]+`, I am close to max luminance, so I am going to skip turn-in.`}
				SetState {Finished}
	IF:	Always
		DO:	DoAll
				Chat {/f Cheese it, it's the fuzz!}
				Chat {/me decides to make a break for it.}
				EmbedNav nav3__Frozen_Valley___Completion_nav {Frozen Valley - Completion.nav}
				SetOpt {EnableCombat} {False}
				SetOpt {EnableLooting} {False}
				SetOpt {EnableNav} {True}
	IF:	NavEmpty
		DO:	SetState {Finished}
~~ }
STATE: {EquipEquipment} ~~ {
	IF:	Expr {testpvar[Trinkets]==0||@Trinkets{{TurnInTrinket}}==`NotSet`||@Trinkets{{DefaultTrinket}}==`NotSet`}
		DO:	Return
	IF:	Expr {$TurnInEquipment==1}
		DO:	ChatExpr {`/mt dequip `+@Trinkets{{DefaultTrinket}}}
	IF:	All
			Expr {$TurnInEquipment==1}
			SecsInStateGE 2
		DO:	DoAll
				ChatExpr {`/mt equip `+@Trinkets{{TurnInTrinket}}}
				DoExpr {$TurnInEquipment=2}
				Return
	IF:	Expr {$TurnInEquipment==2}
		DO:	ChatExpr {`/mt dequip `+@Trinkets{{TurnInTrinket}}}
	IF:	All
			Expr {$TurnInEquipment==2}
			SecsInStateGE 2
		DO:	DoAll
				ChatExpr {`/mt equip `+@Trinkets{{DefaultTrinket}}}
				DoExpr {$TurnInEquipment=0}
				Return
~~ }
STATE: {Finished} ~~ {
	IF:	Always
		DO:	DoAll
				ChatExpr {`/vt settings load `+getcharstringprop[1]+`TempBackup`}
	IF:	All
			Expr {getfellowshipisleader[]==1}
			Expr {&MetaQueueStart==1}
		DO:	DoAll
				DoExpr {&MetaStage=&MetaStage+1}
				DoExpr {cleargvar[RalliedChars]}
	IF:	SecsInStateGE 1
		DO:	DoAll
				EmbedNav nav4__NavToMansion_nav {NavToMansion.nav}
				SetOpt {EnableNav} {True}
	IF:	All
			SecsInStateGE 60
			Expr {&MetaQueueStart==1}
			NavEmpty
		DO:	ChatExpr {`/vt meta load MetaQ`}
~~ }


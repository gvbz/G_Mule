STATE: {Buffing} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableBuffing} {True}
				Chat {/vt forcebuff}
				DoExpr {$SettingsApplied=0}
	IF:	All
			Expr {getfellowshipisleader[]==1}
			SecsInStateGE 180
		DO:	DoAll

				SetState {Flagging}
	IF:	ChatMatch {Tally ho!}
		DO:	SetState {Flagging}
~~ }
STATE: {Flagging} ~~ {
	IF:	Expr {getisspellknown[5541]==1} ~~ SpellId 5541 is "Lost City of Neftet Recall".
		DO:	DoAll
				EmbedNav nav0__Neftet_KT___FlaggingRecall_nav {Neftet KT - FlaggingRecall.nav}
				SetOpt {EnableBuffing} {False}
				SetOpt {EnableCombat} {False}
				SetOpt {EnableLooting} {False}
				SetOpt {EnableNav} {True}
				SetWatchdog 10 120 {Flagging}
	IF:	Expr {getisspellknown[5541]==0} ~~ SpellId 5541 is "Lost City of Neftet Recall".
		DO:	DoAll
				EmbedNav nav1__Netftet_KT___Flagging_nav {Netftet KT - Flagging.nav}
				SetOpt {EnableBuffing} {False}
				SetOpt {EnableCombat} {False}
				SetOpt {EnableLooting} {False}
				SetOpt {EnableNav} {True}
				SetWatchdog 10 120 {Flagging}
	IF:	NavEmpty
		DO:	SetState {Rally}
~~ }
STATE: {Rally} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableNav} {False}
				SetOpt {EnableCombat} {True}
				ClearWatchdog
	IF:	All
			SecsInStateGE 5
			CellE 87640033
			Expr {listcontains[getgvar[RalliedChars],getcharstringprop[1]]==0}
		DO:	DoExpr {listadd[getgvar[RalliedChars],getcharstringprop[1]]}
	IF:	Expr {listcount[getgvar[RalliedChars]]==getfellowshipcount[]}
		DO:	SetState {Fighting}
	IF:	SecsInStateGE 30
		DO:	SetState {Rally}
~~ }
STATE: {Fighting} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableBuffing} {True}
				SetOpt {EnableCombat} {True}
				SetOpt {EnableLooting} {True}
	IF:	Expr {getfellowshipisleader[]==1}
		DO:	EmbedNav nav2__Neftet_KT___Patrol_nav {Neftet KT - Patrol.nav}
	IF:	Expr {getfellowshipisleader[]==0}
		DO:	DoAll
				ChatExpr {`/ub follow `+getvar[LeaderName]}
				SetOpt {NavPriorityBoost} {True}
	IF:	SecsInStateGE 1
		DO:	SetOpt {EnableNav} {True}
	IF:	All
			Expr {$PickupLandscapeItems==1}
			Expr {getfellowshipisleader[]==1}
			Expr {wobjectgetname[wobjectfindnearestbyobjectclass[8]]==Prickly Pear}
			Expr {coordinatedistancewithz[getplayercoordinates[], wobjectgetphysicscoordinates[wobjectfindnearestbynameandobjectclass[8, Prickly Pear]]]<=10}
		DO:	DoAll
				DoExpr {setvar[ItemName, Prickly Pear]}
				SetState {Pickup}
	IF:	All
			Expr {$PickupLandscapeItems==1}
			Expr {wobjectgetname[wobjectfindnearestbyobjectclass[8]]==Desert Flower}
			Expr {coordinatedistancewithz[getplayercoordinates[], wobjectgetphysicscoordinates[wobjectfindnearestbynameandobjectclass[8, Desert Flower]]]<=10}
			ItemCountLE 10 {Desert Flower}
		DO:	DoAll
				DoExpr {setvar[ItemName, Desert Flower]}
				SetState {Pickup}
	IF:	All
			Expr {$PickupLandscapeItems==1}
			Expr {wobjectgetname[wobjectfindnearestbyobjectclass[8]]==Corpse of Cracked Stone Tablet}
			Expr {coordinatedistancewithz[getplayercoordinates[], wobjectgetphysicscoordinates[wobjectfindnearestbynameandobjectclass[27, Corpse of Cracked Stone Tablet]]]<=20}
		DO:	DoAll
				DoExpr {setvar[ItemName, Corpse of Cracked Stone Tablet]}
				SetState {Pickup}
	IF:	All
			Expr {getfellowshipisleader[]==1}
			SecsInStateGE 10
		DO:	DoExpr {cleargvar[RalliedChars]}
	IF:	All
			Expr {$PickupLandscapeItems==1}
			Expr {$TaskArmoredillo==1}
			Expr {$TaskBracers==1}
			Expr {$TaskGolem==1}
			Expr {$TaskMuMiyah==1}
			Expr {$TaskPricklyPear==1}
			Expr {$TaskReedshark==1}
			Expr {$TaskBrokenStoneTablet==1}
		DO:	SetState {Completion}
	IF:	All
			Expr {$PickupLandscapeItems==0}
			Expr {$TaskArmoredillo==1}
			Expr {$TaskGolem==1}
			Expr {$TaskMuMiyah==1}
			Expr {$TaskReedshark==1}
			Expr {$TaskDesertCactus==1}
		DO:	SetState {Completion}
	IF:	ChatMatch {Cheese it, it's the fuzz!}
		DO:	SetState {Completion}
	IF:	ChatMatch {Armoredillos! Your task is complete}
		DO:	DoExpr {setvar[TaskArmoredillo, 1]}
	IF:	ItemCountGE 15 {Engraved A'nekshay Bracers}
		DO:	DoExpr {setvar[TaskBracers, 1]}
	IF:	ChatMatch {Golems! Your task is complete}
		DO:	DoExpr {setvar[TaskGolem, 1]}
	IF:	ChatMatch {You have killed 30 Mu-miyah}
		DO:	DoExpr {setvar[TaskMuMiyah, 1]}
	IF:	ItemCountGE 15 {Prickly Pear}
		DO:	DoExpr {setvar[TaskPricklyPear, 1]}
	IF:	ChatMatch {You have killed 30 Reedshark}
		DO:	DoExpr {setvar[TaskReedshark, 1]}
	IF:	ChatMatch {You have killed 6 Desert Cactus}
		DO:	DoExpr {setvar[TaskDesertCactus, 1]}
	IF:	Death
		DO:	SetState {Return on Death}
~~ }
STATE: {Pickup} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableNav} {False}
				ChatExpr {`/ub uselp `+$ItemName}
	IF:	SecsInStateGE 10
		DO:	SetState {Fighting}
~~ }
STATE: {Return on Death} ~~ {
	IF:	Expr {getisspellknown[5541]==1} ~~ SpellId 5541 is "Lost City of Neftet Recall".
		DO:	EmbedNav nav3__Neftet_KT___ReturnOnDeath_nav {Neftet KT - ReturnOnDeath.nav}
	IF:	Expr {getisspellknown[5541]==0} ~~ SpellId 5541 is "Lost City of Neftet Recall".
		DO:	EmbedNav nav4__Neftet_KT___ReturnOnDeath_NoRecall_nav {Neftet KT - ReturnOnDeath NoRecall.nav}
	IF:	Always
		DO:	DoAll
				SetOpt {EnableNav} {True}
				SetOpt {EnableBuffing} {True}
	IF:	NavEmpty
		DO:	SetState {Fighting}
~~ }
STATE: {Finished} ~~ {
	IF:	Always
		DO:	DoAll
				ChatExpr {`/vt settings load `+getcharstringprop[1]+`TempBackup`}
	IF:	All
			Expr {getfellowshipisleader[]==1}
			Expr {&MetaQueueStart==1}
		DO:	DoAll
				DoExpr {&MetaStage=&MetaStage+1}
				DoExpr {cleargvar[RalliedChars]}
	IF:	SecsInStateGE 1
		DO:	DoAll
				EmbedNav nav5__NavToMansion_nav {NavToMansion.nav}
				SetOpt {EnableNav} {True}
	IF:	All
			SecsInStateGE 60
			Expr {&MetaQueueStart==1}
			NavEmpty
		DO:	ChatExpr {`/vt meta load MetaQ`}
~~ }
STATE: {Completion} ~~ {
	IF:	Expr {$TurnInEquipment==1}
		DO:	CallState {EquipEquipment} {Completion}
	IF:	Expr {getcharquadprop[6]>=1490000}
		DO:	DoAll
				ChatExpr {`/t `+getcharstringprop[1]+`, I am close to max luminance, so I am going to skip turn-in.`}
				SetState {Finished}
	IF:	Always
		DO:	DoAll
				Chat {/f Cheese it, it's the fuzz!}
				Chat {/me decides to make a break for it.}
				SetOpt {EnableCombat} {False}
				SetOpt {EnableLooting} {False}
				SetOpt {EnableNav} {True}
				SetOpt {CorpseApproachRange-Max} {0.02083333}
	IF:	Expr {getisspellknown[5541]==1} ~~ SpellId 5541 is "Lost City of Neftet Recall".
		DO:	EmbedNav nav6__Neftet_KT___Turn_In_nav {Neftet KT - Turn In.nav}
	IF:	Expr {getisspellknown[5541]==0} ~~ SpellId 5541 is "Lost City of Neftet Recall".
		DO:	EmbedNav nav7__Neftet_KT___Turn_In_NoRecall_nav {Neftet KT - Turn In NoRecall.nav}
	IF:	NavEmpty
		DO:	SetState {Finished}
~~ }
STATE: {EquipEquipment} ~~ {
	IF:	Expr {testpvar[Trinkets]==0||@Trinkets{{TurnInTrinket}}==`NotSet`||@Trinkets{{DefaultTrinket}}==`NotSet`}
		DO:	Return
	IF:	Expr {$TurnInEquipment==1}
		DO:	ChatExpr {`/mt dequip `+@Trinkets{{DefaultTrinket}}}
	IF:	All
			Expr {$TurnInEquipment==1}
			SecsInStateGE 2
		DO:	DoAll
				ChatExpr {`/mt equip `+@Trinkets{{TurnInTrinket}}}
				DoExpr {$TurnInEquipment=2}
				Return
	IF:	Expr {$TurnInEquipment==2}
		DO:	ChatExpr {`/mt dequip `+@Trinkets{{TurnInTrinket}}}
	IF:	All
			Expr {$TurnInEquipment==2}
			SecsInStateGE 2
		DO:	DoAll
				ChatExpr {`/mt equip `+@Trinkets{{DefaultTrinket}}}
				DoExpr {$TurnInEquipment=0}
				Return
~~ }


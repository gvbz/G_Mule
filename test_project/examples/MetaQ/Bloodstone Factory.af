STATE: {MetaQueueStart} ~~ {
	IF:	Always
		DO:	DoExpr {setvar[LeaderName,wobjectgetname[wobjectfindbyid[getfellowshipleaderid[]]]]}
	IF:	Expr {getfellowshipisleader[]==1}
		DO:	DoAll
				Chat {/me will be the leader of this group. Starting Bloodstone Factory.}
				DoExpr {setgvar[RalliedChars,listcreate[]]}
	IF:	Expr {testpvar[Trinkets]!=0}
		DO:	DoExpr {$TurnInEquipment=1}
	IF:	All
			Expr {&BloodstoneTurnInFlag==0}
			Expr {getfellowshipisleader[]==1}
		DO:	DoExpr {echo[`[MetaQ] WARNING: Bloodstone Factory turn-in DISABLED for the team.`,15]}
	IF:	All
			Expr {&BloodstoneTurnInFlag==1}
			Expr {getfellowshipisleader[]==1}
		DO:	DoExpr {echo[`[MetaQ] WARNING: Bloodstone Factory turn-in ENABLED for the team.`,15]}
	IF:	Expr {@BloodstoneWandForLum==1}
		DO:	ChatExpr {`/f Warning - I will be handing in my Bloodstone wand for luminance`}
	IF:	SecsInStateGE 5
		DO:	SetState {Buffing}
~~ }
STATE: {Buffing} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {EnableBuffing} {True}
				Chat {/vt forcebuff}
				DoExpr {$SettingsApplied=0}

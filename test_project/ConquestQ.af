~~ ConquestQ.af
~~ Meta for automating daily quests and hunting.
~~
~~ This meta opens a setup view in the Default state, allows the user to enable or
~~ disable the TusksAndPincers quest, starts that meta when enabled, and then moves
~~ into a hunting state once quest completion has been confirmed.
~~ }

STATE: {Default} ~~ {
	~~ If a previous run already marked the quest complete, jump straight into hunting.
	IF: Expr {getvar[QuestTusksAndPincersComplete]==1}
		DO: SetState {Hunting}
	~~ Otherwise, present the configuration view and initialize the selection flags.
	IF: Always
		DO: DoAll
				DoExpr {setvar[QuestTusksAndPincersActive,0]}
				DoExpr {setvar[QuestTusksAndPincersComplete,0]}
				DestroyAllViews
				CreateView {ConquestQSetupView} {<?xml version="1.0"?><view width="340" height="240" title="ConquestQ Setup"><control type="layout"><control type="button" name="EnableTusks" left="12" top="12" width="150" height="42" text="Enable Tusks" actionexpr="setvar[QuestTusksAndPincersActive,1]&amp;&amp;echo[ConquestQ: Tusks and Pincers enabled.]"/><control type="button" name="DisableTusks" left="178" top="12" width="150" height="42" text="Disable Tusks" actionexpr="setvar[QuestTusksAndPincersActive,0]&amp;&amp;echo[ConquestQ: Tusks and Pincers disabled.]"/><control type="button" name="Start" left="80" top="168" width="180" height="42" text="Start ConquestQ" setstate="StartQuesting" /></control></view>}
				Chat {ConquestQ: Ready. Choose your options and press Start.}
~~ }

STATE: {StartQuesting} ~~ {
	~~ If the quest was enabled, start the TusksAndPincers meta and wait for it to finish.
	IF: Expr {getvar[QuestTusksAndPincersActive]==1}
		DO: DoAll
				DestroyView {ConquestQSetupView}
				Chat {ConquestQ: Starting TusksAndPincers.}
				Chat {/vt meta load TusksAndPincers}
				Chat {/vt start}
				SetState {AwaitTusksAndPincers}
	~~ If it was disabled, skip straight into hunting mode.
	IF: Expr {getvar[QuestTusksAndPincersActive]==0}
		DO: DoAll
				DestroyView {ConquestQSetupView}
				Chat {ConquestQ: TusksAndPincers disabled. Moving straight to hunting.}
				SetState {Hunting}
~~ }

STATE: {AwaitTusksAndPincers} ~~ {
	~~ This state is meant to wait until your quest meta sets the completion flag.
	~~ In practice, a companion meta can set the variable and then reload ConquestQ.
	IF: Expr {getvar[QuestTusksAndPincersComplete]==1}
		DO: DoAll
				Chat {ConquestQ: TusksAndPincers completion confirmed.}
				Chat {/vt meta load ConquestQ}
				SetState {Hunting}
	IF: Always
		DO: None
~~ }

STATE: {Hunting} ~~ {
	~~ Perform a recall if the character is not in the intended home landblock.
	~~ Replace the placeholder landblock below with the correct one for your setup.
	IF: All
			Not BlockE 00000000
			SecsInStateGE 2
		DO: DoAll
				Chat {/ls recall}
				Chat {ConquestQ: Recall issued.}
	~~ Turn on the Virindi Tank options needed for hunting and navigation.
	IF: Always
		DO: DoAll
				SetOpt {enablecombat} {true}
				SetOpt {enablebuffing} {true}
				SetOpt {enablenav} {true}
				SetOpt {enablelooting} {true}
				EmbedNav nav0__Hunting_Route {hunting_route.nav}
				Chat {ConquestQ: Hunting mode active.}
~~ }

~~========================= ONLY NAVS APPEAR BELOW THIS LINE =========================~~

NAV: nav0__Hunting_Route once ~~ {
	~~ Placeholder route. Replace the node below with your actual hunting route later.
	pau 0 0 0 1000
	~~ }
